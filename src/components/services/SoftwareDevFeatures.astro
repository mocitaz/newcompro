---
// src/components/services/SoftwareDevFeatures.astro
import { getTranslations, type Locale } from '../../i18n/translations';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = getTranslations(lang);
const features = t.softwareDevService.features;
---

<section
  id="what-we-deliver"
  aria-label={features.headline}
  class="relative isolate bg-white py-12 sm:py-20 lg:py-28"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header Centered -->
    <div class="max-w-3xl mx-auto text-center mb-8 sm:mb-14 lg:mb-20 reveal-init" data-reveal="title">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-medium text-slate-950 tracking-[-0.04em] font-sans leading-tight">
        {features.headline}
      </h2>
      <p class="mt-3 sm:mt-4 text-sm sm:text-base text-slate-600 leading-relaxed font-normal font-sans max-w-2xl mx-auto">
        {features.subheadline}
      </p>
    </div>

    <!-- 3-Column Compact Editorial Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 items-stretch">
      {features.items.map((item, index) => {
        const rowIndex = Math.floor(index / 3);
        return (
          <div
            data-reveal="scale"
            class={`feature-card feature-row-${rowIndex} feature-card-${index} group relative flex min-h-0 sm:min-h-[17.5rem] flex-col justify-between overflow-hidden rounded-[20px] border border-slate-200/85 bg-white p-5 sm:p-7 reveal-scale-init stagger-${(index % 3) + 1}`}
          >
            <!-- Top Bar: Icon at Top Left -->
            <div class="relative z-10 flex items-start justify-between">
              <span class="w-8 h-8 sm:w-9 sm:h-9 text-slate-900 flex items-center justify-center" aria-hidden="true">
                {item.icon === 'business' && (
                  <svg class="w-7 h-7 sm:w-8 sm:h-8 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="2" y="7" width="20" height="14" rx="2" ry="2" />
                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
                  </svg>
                )}
                {item.icon === 'shield' && (
                  <svg class="w-7 h-7 sm:w-8 sm:h-8 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                    <path d="m9 12 2 2 4-4" />
                  </svg>
                )}
                {item.icon === 'support' && (
                  <svg class="w-7 h-7 sm:w-8 sm:h-8 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
                  </svg>
                )}
                {item.icon === 'scale' && (
                  <svg class="w-7 h-7 sm:w-8 sm:h-8 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z" />
                    <path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z" />
                    <path d="M7 21h10" />
                    <path d="M12 3v18" />
                    <path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2" />
                  </svg>
                )}
                {item.icon === 'lock' && (
                  <svg class="w-7 h-7 sm:w-8 sm:h-8 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="5" y="11" width="14" height="10" rx="2" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 11V7a4 4 0 118 0v4m-4 4v2" />
                  </svg>
                )}
                {item.icon === 'workflow' && (
                  <svg class="w-7 h-7 sm:w-8 sm:h-8 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="3" y="3" width="6" height="6" rx="1" />
                    <rect x="15" y="3" width="6" height="6" rx="1" />
                    <rect x="9" y="15" width="6" height="6" rx="1" />
                    <path d="M6 9v3a1 1 0 0 0 1 1h5m0 0h5a1 1 0 0 0 1-1V9m-6 4v2" />
                  </svg>
                )}
                {item.icon === 'integration' && (
                  <svg class="w-7 h-7 sm:w-8 sm:h-8 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="18" cy="5" r="3" />
                    <circle cx="6" cy="12" r="3" />
                    <circle cx="18" cy="19" r="3" />
                    <line x1="8.59" y1="13.51" x2="15.42" y2="17.49" />
                    <line x1="15.41" y1="6.51" x2="8.59" y2="10.49" />
                  </svg>
                )}
                {item.icon === 'code' && (
                  <svg class="w-7 h-7 sm:w-8 sm:h-8 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <polyline points="16 18 22 12 16 6" />
                    <polyline points="8 6 2 12 8 18" />
                  </svg>
                )}
                {item.icon === 'module' && (
                  <svg class="w-7 h-7 sm:w-8 sm:h-8 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="m7.5 4.27 9 5.15" />
                    <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />
                    <path d="m3.3 7 8.7 5 8.7-5" />
                    <path d="M12 22V12" />
                  </svg>
                )}
              </span>
            </div>

            <!-- Content Area at Bottom of Card -->
            <div class="relative z-10 mt-auto pt-4 sm:pt-6">
              <h3 class="text-lg sm:text-[21px] font-semibold tracking-[-0.025em] text-slate-950 font-sans leading-snug">
                {item.title}
              </h3>
              <p class="mt-2 text-xs sm:text-[13.5px] leading-relaxed text-slate-600 font-normal font-sans">
                {item.desc}
              </p>
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>

<style>
  .feature-card {
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 300ms cubic-bezier(0.16, 1, 0.3, 1), border-color 300ms ease;
  }

  .feature-card:hover {
    border-color: rgba(203, 213, 225, 0.9);
    transform: translateY(-3px);
    box-shadow: 0 16px 36px -8px rgba(0, 0, 0, 0.07);
  }

  /* Multi-spectrum Aurora Ambient Glow */
  .feature-card::before {
    position: absolute;
    top: -2.5rem;
    right: -2rem;
    z-index: 0;
    width: 14.5rem;
    height: 14.5rem;
    border-radius: 9999px;
    content: '';
    filter: blur(28px);
    pointer-events: none;
    transition: transform 400ms cubic-bezier(0.16, 1, 0.3, 1), opacity 400ms ease;
  }

  .feature-card:hover::before {
    transform: scale(1.08);
    opacity: 0.95;
  }

  /* Exactly 3 Harmonious Colors: 1 Color Theme per Row */

  /* Row 1 (Cards 0, 1, 2): Color 1 - Teal & Emerald */
  .feature-row-0::before,
  .feature-card-0::before,
  .feature-card-1::before,
  .feature-card-2::before {
    background: 
      radial-gradient(circle at 62% 35%, rgba(45, 212, 191, 0.50) 0%, rgba(204, 251, 241, 0.20) 38%, transparent 68%),
      radial-gradient(circle at 82% 28%, rgba(52, 211, 153, 0.55) 0%, rgba(167, 243, 208, 0.28) 35%, transparent 72%);
  }

  /* Row 2 (Cards 3, 4, 5): Color 2 - Sky Blue & Indigo */
  .feature-row-1::before,
  .feature-card-3::before,
  .feature-card-4::before,
  .feature-card-5::before {
    background: 
      radial-gradient(circle at 62% 35%, rgba(56, 189, 248, 0.50) 0%, rgba(186, 230, 253, 0.20) 38%, transparent 68%),
      radial-gradient(circle at 82% 28%, rgba(129, 140, 248, 0.55) 0%, rgba(199, 210, 254, 0.28) 35%, transparent 72%);
  }

  /* Row 3 (Cards 6, 7, 8): Color 3 - Signature Violet & Fuchsia */
  .feature-row-2::before,
  .feature-card-6::before,
  .feature-card-7::before,
  .feature-card-8::before {
    background: 
      radial-gradient(circle at 62% 35%, rgba(192, 132, 252, 0.58) 0%, rgba(233, 213, 255, 0.20) 38%, transparent 68%),
      radial-gradient(circle at 82% 28%, rgba(244, 114, 182, 0.52) 0%, rgba(251, 207, 232, 0.28) 35%, transparent 72%);
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-card {
      transition: none;
    }

    .feature-card:hover {
      transform: none;
    }

    .feature-card::before {
      transition: none;
    }

    .feature-card:hover::before {
      transform: none;
    }
  }
</style>
