---
// src/pages/404.astro - Fallback route for all unready / unbuilt pages (Displays EA.png)
import Layout from "../layouts/Layout.astro";
import TopBar from "../components/TopBar.astro";

const currentPath = Astro.url.pathname;
const isId = currentPath === '/id' || currentPath.startsWith('/id/');
const lang = isId ? 'id' : 'en';
const homeUrl = isId ? '/id' : '/';
---

<Layout
  lang={lang}
  title={isId ? "Halaman Dalam Pengembangan | PT Teknalogi Transformasi Digital" : "Page Under Development | PT Teknalogi Transformasi Digital"}
  description={isId ? "Halaman ini sedang dalam tahap pengembangan. Cetak biru arsitektur enterprise PT Teknalogi Transformasi Digital." : "This page is currently under development. Enterprise architecture blueprint of PT Teknalogi Transformasi Digital."}
>
  <TopBar lang={lang} />
  <main class="pt-24 sm:pt-32 pb-16 sm:pb-24 px-4 sm:px-8 max-w-7xl mx-auto flex flex-col items-center min-h-[75vh]">
    <!-- Page Header Title & Context -->
    <div class="w-full max-w-4xl text-center mb-8 sm:mb-12">
      <span class="inline-block text-[11px] sm:text-xs font-semibold uppercase tracking-wider text-amber-700 bg-amber-50 border border-amber-200/80 px-3.5 py-1 rounded-full mb-3 font-mono">
        {isId ? "Halaman Dalam Pengembangan" : "Page Under Development"}
      </span>
      <h1 class="text-2xl sm:text-4xl lg:text-[42px] font-bold text-slate-950 tracking-[-0.025em] leading-[1.2] font-sans">
        {isId ? "Cetak Biru Arsitektur Enterprise" : "Enterprise Architecture Blueprint"}
      </h1>
      <p class="text-slate-600 text-xs sm:text-base leading-relaxed mt-2.5 sm:mt-3.5 font-sans max-w-2xl mx-auto">
        {isId
          ? "Halaman ini sedang dalam tahap finalisasi. Sementara itu, Anda dapat mempelajari arsitektur teknologi enterprise dan fondasi sistem yang kami bangun di bawah ini."
          : "This page is currently being finalized. In the meantime, explore our foundational enterprise architecture blueprint and distributed system frameworks below."}
      </p>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-3">
        <!-- Mobile Touch Hint (Visible only on small viewports) -->
        <div class="sm:hidden inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-slate-100 border border-slate-200 text-slate-600 text-[11px] font-medium">
          <svg class="w-3.5 h-3.5 text-indigo-600 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
          </svg>
          <span>{isId ? "Geser ke samping untuk melihat detail diagram" : "Swipe horizontally to inspect diagram details"}</span>
        </div>

        <a
          href={homeUrl}
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs sm:text-sm font-semibold transition-all duration-200 shadow-2xs cursor-pointer min-h-[40px]"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span>{isId ? "Kembali ke Beranda" : "Return to Home"}</span>
        </a>
      </div>
    </div>

    <!-- Responsive High-Resolution Diagram Frame -->
    <div class="w-full overflow-hidden rounded-2xl sm:rounded-3xl border border-slate-200/90 shadow-xl bg-white">
      <div class="overflow-x-auto overscroll-x-contain scrollbar-thin">
        <div class="min-w-[720px] sm:min-w-0">
          <picture>
            <source srcset="/EA.webp" type="image/webp" />
            <img
              src="/EA.png"
              alt={isId ? "Cetak Biru Arsitektur Enterprise - PT Teknalogi Transformasi Digital" : "Enterprise Architecture - PT Teknalogi Transformasi Digital"}
              class="w-full h-auto block select-none"
              loading="eager"
              decoding="async"
              width="1884"
              height="1080"
            />
          </picture>
        </div>
      </div>
    </div>
  </main>
</Layout>
