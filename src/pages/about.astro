---
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/TopBar.astro';
import AboutFoundation from '../components/AboutFoundation.astro';
import CertificationsMarquee from '../components/CertificationsMarquee.astro';
import BrandValues from '../components/BrandValues.astro';
import EngagementModels from '../components/EngagementModels.astro';
import Faq from '../components/Faq.astro';
import LetsTalk from '../components/LetsTalk.astro';
import BackToTop from '../components/BackToTop.astro';
---

<Layout
  lang="en"
  title="About Us | PT Teknalogi Transformasi Digital"
  description="Learn how PT Teknalogi Transformasi Digital approaches enterprise software engineering, system integration, and long-term cloud operations."
>
  <TopBar lang="en" />
  <main class="bg-white">
    <AboutFoundation lang="en" />
    <BrandValues lang="en" />
    <EngagementModels lang="en" />
    <CertificationsMarquee lang="en" />
    <Faq lang="en" />
    <LetsTalk lang="en" />
  </main>

  <BackToTop label="Back to top" />
</Layout>
