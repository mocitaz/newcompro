---
// src/components/industries/LogisticsIndustry.astro
import type { Locale } from '../../i18n/translations';
import LogisticsAboutIndustry from './LogisticsAboutIndustry.astro';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const isId = lang === 'id';

const copy = isId
  ? {
      eyebrow: 'LOGISTIK & SUPPLY CHAIN MANAGEMENT',
      title: 'Engineering untuk jaringan rantai pasok dan armada logistik terpadu.',
      lead: 'Bangun dan modernisasi platform logistik dengan Transportation Management System (TMS), Warehouse Management System (WMS), telemetri armada IoT real-time, dan otomasi rute pengiriman last-mile. Teknalogi menghadirkan rekayasa perangkat lunak rantai pasok yang tangguh dan terukur.',
      primaryCta: 'Diskusikan kebutuhan logistik Anda',
      challengesTitle: 'Ketika rantai pasok terpisah, pengiriman terhambat.',
      challengesLead: 'Operasional melambat ketika gudang, pelacakan armada, dan kurir berjalan sendiri-sendiri.',
      challenges: [
        ['Visibilitas armada terbatas', 'Posisi armada dan status paket terlambat diperbarui di multi-kurir.'],
        ['Kemacetan sortir gudang', 'Alur pick-and-pack manual memicu salah sortir saat volume tinggi.'],
        ['Rute pengiriman tidak efisien', 'Perencanaan rute statis boros BBM dan lambat merespons macet.'],
        ['Rekonsiliasi ongkir manual', 'Surat jalan (POD) kertas memperlambat penagihan dan settlement kurir.'],
      ],
      solutionsTitle: 'Solusi perangkat lunak terintegrasi untuk penyedia logistik, 3PL, dan armada rantai pasok.',
      solutionsLead: 'Ruang lingkup sistem disesuaikan dengan skala distribusi institusi Anda, mulai dari orkestrasi freight multi-moda, otomatisasi WMS bebas selisih stok, hingga pelacakan telemetri dingin (cold-chain).',
      solutions: [
        ['Transportation Management System (TMS)', 'Orkestrasi siklus pengiriman terpadu mulai dari tender muatan multi-moda hingga penugasan kurir otomatis.', 'tms'],
        ['Cloud-Native Warehouse System (WMS)', 'Manajemen tata letak slot rak, otomasi picking gelombang (wave picking), dan sistem cross-docking cepat.', 'wms'],
        ['Telemetri IoT & Pelacakan Armada', 'Pelacakan GPS geofence real-time, sensor suhu cold-chain, dan pemantauan perilaku pengemudi instan.', 'telemetry'],
        ['Optimasi Rute & Distribusi Last-Mile', 'Penentuan urutan titik rute multi-stop adaptif dengan mempertimbangkan kapasitas armada dan jendela waktu.', 'route'],
        ['Surat Jalan Digital (e-POD) & Tagihan', 'Aplikasi kurir dengan tanda tangan digital offline, foto bukti serah terima, dan pembukaan invoice instan.', 'pod'],
        ['Otomasi Tarif & Rekonsiliasi Logistik', 'Kalkulasi otomatis berat volumetrik (CBM/KG) dan rekonsiliasi faktur ongkos kirim mitra 3PL.', 'billing'],
      ],
      approachTitle: 'Dirancang untuk visibilitas muatan real-time dan efisiensi rute pengiriman.',
      domains: [
        ['Optimasi Rute Multi-Titik & Kapasitas', 'Terapkan algoritma metaheuristik untuk menentukan urutan stop armada paling efisien guna menekan konsumsi BBM.', 'routing'],
        ['Mesin Geofence & Aliran Event Telemetri', 'Proses ribuan event sensor per detik untuk memicu peringatan deviasi rute dan pemantauan suhu cold-chain seketika.', 'tracking'],
        ['Sortasi Gudang Berkecepatan Tinggi & Status Bin', 'Gunakan cache memori terdistribusi untuk alokasi bin inventori sub-detik tanpa risiko selisih stok saat picking.', 'sortation'],
      ],
      faqTitle: 'Hal yang biasanya dibahas sebelum proyek logistik dimulai.',
      faqLead: 'Karakteristik armada, volume SKU harian, dan jaringan gudang setiap entitas logistik berbeda. Discovery teknis kami memetakan integrasi hardware, throughput sensor, dan arsitektur pengiriman.',
      faqTrustTitle: 'Dipercaya oleh',
      faqTrustText: 'Perusahaan logistik, distributor, dan pengelola armada di Indonesia',
      faqAction: 'Tanyakan kebutuhan logistik Anda',
      faqs: [
        ['Bisakah platform logistik Teknalogi diintegrasikan dengan ERP yang sudah ada seperti SAP atau Oracle?', 'Ya. Kami membangun antarmuka REST API dan webhook terstandarisasi untuk sinkronisasi pesanan penjualan, master data SKU, status persediaan, dan tagihan invoice secara dua arah dengan ERP Anda.'],
        ['Bagaimana aplikasi mobile driver menangani pengantaran di daerah tanpa sinyal seluler?', 'Aplikasi e-POD kami dirancang dengan arsitektur offline-first (Local SQLite/WatermelonDB). Driver tetap dapat menyelesaikan rute, mengambil foto bukti, dan mencatat tanda tangan digital yang otomatis tersinkron saat koneksi internet kembali.'],
        ['Apakah sistem pelacakan armada mendukung berbagai merek GPS tracker pihak ketiga?', 'Ya. Gateway telemetri IoT kami mendukung berbagai protokol komunikasi perangkat keras (seperti Concox, Queclink, Teltonika, Meitrack) serta transmisi data OBD-II melalui standar MQTT / TCP socket.'],
        ['Bagaimana mesin optimasi rute memperhitungkan aturan lalu lintas ganjil-genap dan batas tonase truk?', 'Algoritma routing kami mengonfigurasi batasan dinamis (vehicle routing problem with constraints) yang memetakan plat nomor armada terhadap jadwal ganjil-genap zona kota dan batas kelas jalan kendaraan berat.'],
        ['Bisakah sistem WMS memproses pemindaian barcode batch dan RFID reader?', 'Bisa. Modul WMS kami terhubung langsung dengan perangkat handheld barcode scanner (Zebra, Honeywell) dan gerbang RFID portal untuk pencatatan penerimaan barang dan picking massal.'],
        ['Bagaimana sistem mendeteksi ketidaksesuaian tarif ongkos kirim dari vendor kurir 3PL?', 'Mesin rekonsiliasi kami mencocokkan dimensi CBM/KG aktual di gudang terhadap faktur tagihan mitra secara otomatis dan langsung memasukkan perbedaan tarif ke antrean audit pengecualian.'],
        ['Berapa lama estimasi implementasi sistem TMS dan WMS dari tahap discovery hingga go-live?', 'Tergantung pada kompleksitas alur kerja dan integrasi perangkat keras, implementasi modular biasanya memakan waktu 8 hingga 16 minggu dengan fase uji coba paralel di hub percontohan.'],
        ['Apakah Teknalogi menyediakan pemeliharaan server dan monitoring throughput data GPS?', 'Ya. Kami menyediakan layanan managed services mencakup monitoring latensi Kafka/Redis 24/7, pembaruan keamanan OS, optimalisasi basis data geospasial, dan dukungan penanganan insiden.'],
      ],
    }
  : {
      eyebrow: 'LOGISTICS & SUPPLY CHAIN ENGINEERING',
      title: 'Engineering for resilient freight networks and unified supply chains.',
      lead: 'Build and modernize mission-critical logistics platforms with intelligent Transportation Management Systems (TMS), Warehouse Management (WMS), real-time IoT fleet telemetry, and automated last-mile dispatch routing. Teknalogi delivers high-throughput software engineering for complex global and domestic freight operations.',
      primaryCta: 'Discuss your logistics requirements',
      challengesTitle: 'When supply chains disconnect, delivery schedules fail.',
      challengesLead: 'Operations slow down when inventory, fleet tracking, and carriers operate in silos.',
      challenges: [
        ['Fragmented fleet visibility', 'Vehicle locations and delivery updates remain delayed across carriers.'],
        ['Warehouse bottlenecks', 'Manual pick-and-pack workflows cause sorting errors during peak volumes.'],
        ['Suboptimal route planning', 'Static delivery routes increase fuel overhead and fail to adapt to live traffic.'],
        ['Manual freight reconciliation', 'Paper delivery slips delay billing cycles and carrier settlements.'],
      ],
      solutionsTitle: 'Integrated software solutions engineered for 3PL providers, carriers, and enterprise supply chains.',
      solutionsLead: 'System architectures are custom-tailored to your distribution network, spanning multi-modal freight orchestration, discrepancy-free WMS fulfillment, and continuous cold-chain telemetry.',
      solutions: [
        ['Transportation Management System (TMS)', 'End-to-end shipment lifecycle orchestration from multi-modal load tendering to dynamic carrier dispatch.', 'tms'],
        ['Cloud-Native Warehouse System (WMS)', 'High-density slotting, batch pick-and-pack wave management, and automated SKU cross-docking.', 'wms'],
        ['Real-Time IoT Fleet Telemetry', 'Live GPS geofencing, cold-chain sensor telemetry, and driver behavior analytics with sub-second ingestion.', 'telemetry'],
        ['Dynamic Route & Last-Mile Optimization', 'Algorithmic multi-stop route sequencing factoring traffic constraints, time windows, and vehicle capacity.', 'route'],
        ['Digital Proof of Delivery (e-POD)', 'Mobile driver app with offline biometric e-signatures, photo inspection, and instant invoicing settlement.', 'pod'],
        ['Freight Tariff & Billing Reconciliation', 'Automated volumetric dimensional weight (CBM/KG) calculation and automated 3PL carrier invoice audits.', 'billing'],
      ],
      approachTitle: 'Designed for real-time freight visibility and operational routing efficiency.',
      domains: [
        ['Multi-Stop Route Optimization & Capacity', 'Deploy constraint-based metaheuristic engines to determine optimal driver stop sequences and cut fleet fuel burn.', 'routing'],
        ['Geofence Engine & Telemetry Event Streams', 'Process thousands of IoT sensor pings per second to trigger instantaneous route deviation alerts and cold-chain monitors.', 'tracking'],
        ['High-Velocity Warehouse Sortation & Bin State', 'Leverage distributed memory state caches for sub-second inventory bin allocations and zero pick conflicts.', 'sortation'],
      ],
      faqTitle: 'What teams usually discuss before a logistics project starts.',
      faqLead: 'Fleet footprints, daily SKU throughput, and warehouse facility topologies vary. Technical discovery maps hardware integrations, telemetry stream bandwidth, and freight architecture.',
      faqTrustTitle: 'Trusted by',
      faqTrustText: 'Logistics operators, freight distributors, and fleet managers across Indonesia',
      faqAction: 'Ask about your logistics requirements',
      faqs: [
        ['Can Teknalogi integrate logistics platforms with existing ERPs like SAP or Oracle?', 'Yes. We engineer bi-directional REST APIs and webhook connectors to synchronize sales orders, master SKU catalogues, real-time inventory balances, and freight invoices with your enterprise ERP.'],
        ['How does the mobile driver application operate in areas without cellular reception?', 'Our e-POD mobile architecture is built offline-first using embedded local datastores (SQLite/WatermelonDB). Drivers can sequence deliveries, capture photo proofs, and log signatures, which automatically sync once connectivity is restored.'],
        ['Does the fleet telemetry platform support diverse third-party GPS hardware trackers?', 'Yes. Our IoT ingestion gateway supports multi-vendor tracker protocols (including Concox, Queclink, Teltonika, Meitrack) as well as vehicle OBD-II telemetry streamed over standard MQTT and TCP sockets.'],
        ['How does the route optimization engine handle municipal traffic rules and heavy-vehicle road restrictions?', 'Our routing algorithms enforce dynamic constraint parameters that cross-reference vehicle registration plates against urban odd-even restriction zones, low-emission boundaries, and axle weight limits.'],
        ['Can the WMS module interface directly with industrial barcode scanners and RFID tunnels?', 'Yes. The WMS architecture interfaces natively with enterprise Android handheld scanners (Zebra, Honeywell) and automated RFID portal checkpoints for high-speed receiving and wave picking validation.'],
        ['How does the platform detect tariff discrepancies in 3PL carrier freight invoices?', 'Our automated reconciliation engine computes theoretical freight tariffs based on actual warehouse CBM/weight scans and instantly flags billing overcharges into a dedicated dispute resolution queue.'],
        ['What is the typical deployment timeline from discovery to system go-live?', 'Depending on workflow complexity and hardware integration scope, modular TMS and WMS implementations typically span 8 to 16 weeks, including phased pilot testing at selected distribution hubs.'],
        ['Does Teknalogi provide managed cloud infrastructure and GPS data stream monitoring?', 'Yes. We provide 24/7 managed infrastructure support covering Kafka and Redis telemetry latency monitoring, database geospatial query tuning, security patching, and incident response.'],
      ],
    };

const partnerLogos = [
  ['Anytime Fitness', '/partners/anytime.png'],
  ['KelolaAja', '/partners/kelolaaja.png'],
  ['Nikawa Teknika', '/partners/nikawa.png'],
  ['PT Inti Bersama', '/partners/ptintibersama.png'],
];
---

<!-- Hero Section with Background Image and Gradient Overlay -->
<section class="relative isolate min-h-[38rem] overflow-hidden bg-white py-28 sm:min-h-[42rem] sm:py-32 lg:min-h-[46rem] lg:py-40" aria-labelledby="logistics-title">
  <picture>
    <source srcset="/industry/herologistic.webp" type="image/webp" />
    <img src="/industry/herologistic.png" alt="" width="1536" height="1024" class="absolute inset-0 -z-20 h-full w-full object-cover object-[64%_center]" loading="eager" decoding="async" />
  </picture>
  <div class="absolute inset-0 -z-10 bg-white/84 sm:bg-gradient-to-r sm:from-white sm:from-[7%] sm:via-white/86 sm:via-[46%] sm:to-white/0 sm:to-[80%]"></div>
  <div class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-40 bg-gradient-to-b from-transparent to-white"></div>
  <div class="home-container flex min-h-[calc(38rem-7rem)] items-end sm:min-h-[calc(42rem-8rem)] lg:min-h-[calc(46rem-10rem)]">
    <div class="max-w-3xl pb-2 lg:pb-5">
      <p data-reveal="title" class="text-[11px] font-semibold tracking-[0.14em] text-slate-600">{copy.eyebrow}</p>
      <h1 id="logistics-title" data-reveal="title" class="stagger-1 mt-4 max-w-3xl text-4xl font-medium leading-[1.06] tracking-[-0.05em] text-slate-950 sm:text-5xl lg:text-[4.5rem]">
        {copy.title}
      </h1>
      <p data-reveal="text" class="stagger-2 mt-6 max-w-xl text-base leading-relaxed text-slate-700 sm:text-lg">{copy.lead}</p>
      <a data-reveal="scale" href="https://wa.me/628517442245" target="_blank" rel="noopener noreferrer" class="stagger-3 mt-8 inline-flex min-h-12 items-center justify-center rounded-full bg-[#f5a623] px-6 text-sm font-semibold text-slate-950 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:bg-[#e69818] hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 focus-visible:ring-offset-2">
        {copy.primaryCta}
      </a>
    </div>
  </div>
</section>

<!-- Challenges Section with Sticky Secondary Photo and Numbered Grid -->
<section class="home-section bg-white" aria-labelledby="logistics-challenges-title">
  <div class="home-container grid grid-cols-1 gap-10 lg:grid-cols-2 lg:items-stretch lg:gap-12">
    <div data-reveal="scale" class="group relative overflow-hidden rounded-[24px] lg:sticky lg:top-28 lg:self-start">
      <picture>
        <source srcset="/industry/secondarylogistic.webp" type="image/webp" />
        <img src="/industry/secondarylogistic.png" alt="Logistics operations and modern supply chain infrastructure" width="1448" height="1086" class="h-[21rem] w-full object-cover sm:h-[28rem] lg:h-[38rem]" loading="lazy" decoding="async" />
      </picture>
      <div class="absolute inset-0 bg-slate-950/30 transition-opacity duration-500 ease-out group-hover:opacity-0"></div>
      <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-slate-950/65 to-transparent"></div>
      <div class="absolute inset-x-0 bottom-0 p-6 sm:p-7">
        <span class="font-mono text-[10px] font-semibold tracking-[0.18em] text-white/80">CONNECTED FREIGHT & FLEET</span>
      </div>
    </div>
    <div class="flex flex-col">
      <h2 id="logistics-challenges-title" data-reveal="title" class="max-w-xl text-3xl font-medium leading-tight tracking-[-0.04em] text-slate-950 sm:text-4xl lg:text-5xl">{copy.challengesTitle}</h2>
      <p data-reveal="text" class="stagger-1 mt-5 max-w-xl text-sm leading-relaxed text-slate-600 sm:text-base">{copy.challengesLead}</p>
      <ol class="mt-10 grid flex-1 grid-cols-1 gap-x-8 sm:mt-12 sm:grid-cols-2">
        {copy.challenges.map(([title, description], index) => (
          <li data-reveal="scale" class={`group border-t border-slate-200 py-6 sm:py-7 stagger-${index + 1}`}>
            <div class="flex items-baseline justify-between gap-5">
              <span class="font-mono text-xs font-medium tracking-[0.12em] text-slate-400">{String(index + 1).padStart(2, '0')}</span>
              <span class="h-px flex-1 bg-slate-100 transition-colors duration-300 group-hover:bg-violet-200"></span>
            </div>
            <h3 class="mt-7 text-xl font-semibold tracking-[-0.03em] text-slate-950">{title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">{description}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<!-- Solutions Grid Section (6 Cards with Hover Gradient Glow & Custom Icons) -->
<section id="logistics-solutions" class="home-section bg-white scroll-mt-20" aria-labelledby="logistics-solutions-title">
  <div class="home-container">
    <div data-reveal="title" class="mx-auto max-w-3xl text-center">
      <h2 id="logistics-solutions-title" class="text-3xl font-medium leading-tight tracking-[-0.04em] text-slate-950 sm:text-4xl lg:text-5xl">{copy.solutionsTitle}</h2>
      <p class="stagger-1 mx-auto mt-5 max-w-2xl text-sm leading-relaxed text-slate-600 sm:text-base">{copy.solutionsLead}</p>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-4 sm:mt-12 sm:gap-5 md:grid-cols-2 lg:grid-cols-3">
      {copy.solutions.map(([title, description, icon], index) => (
        <article data-reveal="scale" class={`logistics-solution-card group relative isolate flex min-h-[17rem] overflow-hidden rounded-[20px] border border-slate-200/90 bg-white p-6 sm:min-h-[18rem] sm:p-7 stagger-${index + 1}`}>
          <div class="relative z-10 flex w-full flex-col justify-between">
            <span class="logistics-solution-icon flex h-10 w-10 items-center justify-center text-slate-950" aria-hidden="true">
              {icon === 'tms' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M4 8h14v13H4zM18 12h6l4 4v5h-10z" stroke-linejoin="round" />
                  <circle cx="8" cy="24" r="2.5" />
                  <circle cx="23" cy="24" r="2.5" />
                  <path d="M11 24h9M4 21h1.5M26 21h2" stroke-linecap="round" />
                </svg>
              )}
              {icon === 'wms' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M5 6h22v20H5z" stroke-linejoin="round" />
                  <path d="M5 13h22M5 20h22M12 6v20M20 6v20" stroke-linecap="round" />
                  <rect x="7" y="8" width="3" height="3" rx="0.5" fill="currentColor" fill-opacity="0.2" />
                  <rect x="14.5" y="15" width="3" height="3" rx="0.5" fill="currentColor" fill-opacity="0.2" />
                  <rect x="22" y="8" width="3" height="3" rx="0.5" fill="currentColor" fill-opacity="0.2" />
                </svg>
              )}
              {icon === 'telemetry' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M16 4a9 9 0 0 1 9 9c0 6-9 15-9 15S7 19 7 13a9 9 0 0 1 9-9z" stroke-linejoin="round" />
                  <circle cx="16" cy="13" r="3.5" />
                  <path d="M12 28h8" stroke-linecap="round" />
                  <path d="M4 10A14 14 0 0 1 28 10" stroke-dasharray="2 3" stroke-linecap="round" />
                </svg>
              )}
              {icon === 'route' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5">
                  <circle cx="7" cy="7" r="3" />
                  <circle cx="25" cy="25" r="3" />
                  <circle cx="22" cy="9" r="2.5" />
                  <circle cx="10" cy="23" r="2.5" />
                  <path d="M7 10v6a3 3 0 0 0 3 3h4m0 0a3 3 0 0 1 3 3v0a3 3 0 0 0 3 3h2M10 7h9a3 3 0 0 1 3 3v0" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="2 2" />
                </svg>
              )}
              {icon === 'pod' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="7" y="4.5" width="18" height="23" rx="3" stroke-linejoin="round" />
                  <path d="M11 9h10M11 13h10M11 17h6" stroke-linecap="round" />
                  <path d="m14 23 2.5 2.5 5-5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
              {icon === 'billing' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="4.5" y="6" width="23" height="20" rx="3" stroke-linejoin="round" />
                  <path d="M5 11h22M9 16h6M9 20h4" stroke-linecap="round" />
                  <circle cx="21" cy="18.5" r="3.5" />
                  <path d="M21 16.5v4M19.5 18.5h3" stroke-linecap="round" />
                </svg>
              )}
            </span>
            <div class="mt-12">
              <h3 class="max-w-sm text-xl font-medium tracking-[-0.025em] text-slate-950 sm:text-[22px]">{title}</h3>
              <p class="mt-3 max-w-md text-sm leading-relaxed text-slate-600">{description}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- Approach Section (3 Domain Cards with Bespoke Logistics Schematics) -->
<section class="home-section bg-white" aria-labelledby="logistics-approach-title">
  <div class="home-container">
    <div data-reveal="title" class="mx-auto max-w-4xl text-center">
      <h2 id="logistics-approach-title" class="text-3xl font-medium leading-tight tracking-[-0.04em] text-slate-950 sm:text-4xl lg:text-5xl">{copy.approachTitle}</h2>
    </div>
    <div class="mt-10 grid grid-cols-1 gap-4 sm:mt-12 lg:grid-cols-3 lg:gap-5">
      {copy.domains.map(([title, description, key], index) => (
        <article data-reveal="scale" class={`logistics-domain-card logistics-domain-${key} flex min-h-[18rem] flex-col rounded-[20px] border border-slate-200 bg-white p-6 sm:p-7 stagger-${index + 1}`}>
          <div class="flex items-start justify-between gap-5">
            <span class="font-mono text-xs font-medium tracking-[0.12em] text-slate-400">{String(index + 1).padStart(2, '0')}</span>
            <span class="text-[11px] font-medium tracking-[0.08em] text-slate-400">
              {key === 'routing' ? 'OPTIMIZATION' : key === 'tracking' ? 'TELEMETRY' : 'SORTATION'}
            </span>
          </div>
          <div class="logistics-domain-visual mt-5 text-slate-900" aria-hidden="true">
            {key === 'routing' && (
              <svg viewBox="0 0 260 112" fill="none" stroke="currentColor" stroke-width="1.45">
                {/* Node graph with vehicle pin & optimal waypoint trajectory */}
                <path d="M22 56h40c24 0 24-34 50-34s24 64 52 64h42" stroke-linecap="round" stroke-dasharray="3 3" />
                <path d="M22 56c30 0 45-20 72-20s40 40 76 40h54" stroke-linecap="round" stroke-linejoin="round" />
                <circle cx="22" cy="56" r="8" fill="white" />
                <circle cx="94" cy="36" r="10" fill="white" />
                <circle cx="170" cy="76" r="10" fill="white" />
                <circle cx="224" cy="76" r="8" fill="white" />
                <path d="M94 32v8m-4-4h8" stroke-linecap="round" />
                <path d="m166 76 3 3 6-7" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M20 56l4-4-4-4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
            {key === 'tracking' && (
              <svg viewBox="0 0 320 112" fill="none" stroke="currentColor" stroke-width="1.45">
                {/* Geofence polygon, radar sweep circle, and vehicle telemetry beacon */}
                <path d="M20 56h56m38 0h64m38 0h64" stroke-linecap="round" />
                <polygon points="60,26 120,20 150,56 120,92 60,86 40,56" fill="white" stroke-dasharray="2 3" />
                <circle cx="95" cy="56" r="22" fill="white" />
                <circle cx="95" cy="56" r="10" fill="currentColor" fill-opacity="0.1" />
                <circle cx="95" cy="56" r="3" fill="currentColor" />
                <path d="M95 34a22 22 0 0 1 22 22" stroke-linecap="round" />
                <rect x="200" y="34" width="56" height="44" rx="7" fill="white" />
                <path d="M212 48h32M212 56h24M212 64h16" stroke-linecap="round" />
                <circle cx="276" cy="56" r="7" fill="white" />
                <path d="m273 56 2 2 4-5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
            {key === 'sortation' && (
              <svg viewBox="0 0 250 112" fill="none" stroke="currentColor" stroke-width="1.45">
                {/* 3D warehouse rack & automated sortation conveyor lanes */}
                <path d="M20 86h210" stroke-linecap="round" />
