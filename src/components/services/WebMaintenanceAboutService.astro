---
// src/components/services/WebMaintenanceAboutService.astro
import { getTranslations, type Locale } from '../../i18n/translations';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = getTranslations(lang);
const { aboutService } = t.webMaintenanceService;

const getTocLabel = (section: any) => {
  if (section.tocLabel) return section.tocLabel;
  return section.heading || section.title;
};
---

<section
  id="about-service"
  aria-label={aboutService.title}
  class="relative isolate bg-white py-12 sm:py-20 lg:py-32 border-t border-slate-200/80"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
      
      <!-- Left Column: Main Editorial Article -->
      <div class="lg:col-span-8">
        
        <!-- Main Section Title -->
        <h2
          data-reveal="title"
          class="reveal-init text-2xl sm:text-4xl lg:text-[42px] font-bold tracking-[-0.03em] text-slate-950 leading-[1.2] mb-7 sm:mb-14 font-sans"
        >
          {aboutService.title}
        </h2>

        <!-- Mobile Table of Contents (collapsible drawer on small screens) -->
        <div class="lg:hidden mb-8 rounded-2xl border border-slate-200/90 bg-slate-50/80 p-4 sm:p-5">
          <details class="group">
            <summary class="flex items-center justify-between cursor-pointer list-none font-mono text-xs font-bold uppercase tracking-wider text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400 rounded min-h-[44px]">
              <span>{aboutService.tocTitle}</span>
              <svg
                class="w-4 h-4 text-slate-500 transition-transform duration-200 group-open:rotate-180"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <nav class="mt-3 flex flex-col space-y-1.5 border-t border-slate-200/80 pt-3">
              {aboutService.sections.map((section: any) => (
                <a
                  href={`#${section.id}`}
                  class="text-xs sm:text-sm text-slate-600 hover:text-slate-950 transition-colors py-1.5 pl-2.5 border-l-2 border-slate-300 hover:border-slate-900 font-sans min-h-[44px] flex items-center"
                >
                  {getTocLabel(section)}
                </a>
              ))}
            </nav>
          </details>
        </div>

        <!-- Editorial Sections -->
        <div class="flex flex-col space-y-10 sm:space-y-16">
          {aboutService.sections.map((section: any) => (
            <article
              id={section.id}
              class="editorial-section scroll-mt-20 sm:scroll-mt-28 reveal-text-init pb-8 sm:pb-12 border-b border-slate-100 last:border-b-0"
              data-reveal="text"
            >
              <h3 class="text-lg sm:text-2xl font-bold tracking-tight text-slate-950 mb-3 sm:mb-4 font-sans leading-snug">
                {section.heading || section.title}
              </h3>

              {section.paragraphs.map((p: string) => (
                <p class="text-sm sm:text-[16px] leading-[1.72] text-slate-600 font-sans mb-3 sm:mb-4">
                  {p}
                </p>
              ))}

              {(section.list || section.bullets) && (
                <ul class="my-4 sm:my-5 space-y-2.5 sm:space-y-3 pl-4 sm:pl-5 list-disc marker:text-slate-400 text-sm sm:text-[16px] leading-relaxed text-slate-600 font-sans">
                  {(section.list || section.bullets).map((item: any) => (
                    <li>
                      {typeof item === 'string' ? (
                        item
                      ) : (
                        <>
                          <strong class="font-semibold text-slate-900">{item.label}:</strong> {item.text}
                        </>
                      )}
                    </li>
                  ))}
                </ul>
              )}
            </article>
          ))}
        </div>

      </div>

      <!-- Right Column: Sticky Table of Contents -->
      <aside class="hidden lg:block lg:col-span-4 sticky top-28 xl:top-32 self-start">
        <div class="max-h-[calc(100vh-9rem)] overflow-y-auto pl-8 border-l border-slate-200/90 py-1">
          <h3 class="text-[11.5px] font-bold tracking-[0.14em] text-slate-900 uppercase font-mono mb-4 select-none">
            {aboutService.tocTitle}
          </h3>
          <nav aria-label={aboutService.tocTitle} class="flex flex-col space-y-2.5 text-[13.5px] font-sans">
            {aboutService.sections.map((section: any) => (
              <a
                href={`#${section.id}`}
                data-toc-id={section.id}
                class="toc-nav-link text-slate-500 hover:text-slate-950 transition-all duration-200 py-1 pl-3 border-l-2 border-transparent hover:border-slate-400 min-h-[32px] flex items-center"
              >
                {getTocLabel(section)}
              </a>
            ))}
          </nav>
        </div>
      </aside>

    </div>
  </div>
</section>

<script>
  function setupWebMaintenanceTocHighlight() {
    const observerOptions = {
      root: null,
      rootMargin: '-10% 0px -70% 0px',
      threshold: 0,
    };

    const sections = document.querySelectorAll<HTMLElement>('.editorial-section');
    const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-nav-link');

    if (!sections.length || !tocLinks.length) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          tocLinks.forEach((link) => {
            const href = link.getAttribute('href');
            if (href === `#${id}`) {
              link.classList.add('text-slate-950', 'border-slate-900', 'font-semibold');
              link.classList.remove('text-slate-500', 'border-transparent');
            } else {
              link.classList.remove('text-slate-950', 'border-slate-900', 'font-semibold');
              link.classList.add('text-slate-500', 'border-transparent');
            }
          });
        }
      });
    }, observerOptions);

    sections.forEach((sec) => observer.observe(sec));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupWebMaintenanceTocHighlight);
  } else {
    setupWebMaintenanceTocHighlight();
  }
  document.addEventListener('astro:page-load', setupWebMaintenanceTocHighlight);
</script>
