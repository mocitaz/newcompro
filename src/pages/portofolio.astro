---
// src/pages/portofolio.astro - Enterprise Portfolio & Case Studies (EN)
import Layout from "../layouts/Layout.astro";
import TopBar from "../components/TopBar.astro";
import CaseStudiesGrid from "../components/CaseStudiesGrid.astro";
import LetsTalk from "../components/LetsTalk.astro";
import BackToTop from "../components/BackToTop.astro";
import { getTranslations } from "../i18n/translations";

const t = getTranslations("en");
const meta = t.caseStudiesPage.meta;
---

<Layout
  lang="en"
  title={meta.title}
  description={meta.description}
>
  <TopBar lang="en" />
  <main class="min-h-screen bg-white">
    <CaseStudiesGrid lang="en" />
    <LetsTalk lang="en" bgWhite={true} />
  </main>
  <BackToTop label="Back to top" />
</Layout>
