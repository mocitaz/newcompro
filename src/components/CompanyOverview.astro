---
import { getTranslations, type Locale } from '../i18n/translations';

interface Props {
  lang?: Locale;
}

const { lang = 'id' } = Astro.props;
const t = getTranslations(lang);
const overview = t.companyOverview;
---

<section
  id="company-overview"
  aria-labelledby="company-overview-title"
  class="home-section home-container"
>
  <div class="grid grid-cols-1 gap-9 lg:grid-cols-12 lg:items-stretch lg:gap-12 xl:gap-16">
    <div data-reveal class="flex flex-col lg:col-span-7 reveal-init">
      <h2
        id="company-overview-title"
        class="max-w-2xl text-2xl sm:text-3xl lg:text-[2.15rem] font-medium text-slate-950 tracking-[-0.03em] leading-tight font-sans"
      >
        {overview.title}
      </h2>

      <p class="mt-5 max-w-2xl text-sm sm:text-base text-slate-600 leading-relaxed font-normal font-sans">
        {overview.description}
      </p>

      <div class="mt-8 grid grid-cols-2 gap-6 border-t border-slate-300 pt-7 sm:flex sm:items-center sm:gap-10 lg:mt-8">
        {overview.stats.map((stat) => (
          <div class="min-w-0 sm:w-32">
            <strong class="block text-4xl font-semibold leading-none tracking-[-0.05em] text-slate-950 sm:text-[42px]">
              {stat.value}
            </strong>
            <span class="mt-2 block text-sm leading-5 text-slate-600">
              {stat.label}
            </span>
          </div>
        ))}

        <p class="col-span-2 max-w-sm text-sm leading-6 text-slate-600 sm:ml-auto sm:text-right">
          {overview.audience}
        </p>
      </div>
    </div>

    <figure class="aspect-[5/4] overflow-hidden rounded-[18px] bg-slate-100 lg:col-span-5 lg:aspect-auto lg:h-[23rem] lg:self-start reveal-scale-init stagger-2" data-reveal="scale">
      <img
        src="/company-overview-office-v1.png"
        alt={lang === 'id' ? 'Ruang kantor modern dengan pemandangan gedung Jakarta' : 'Modern office interior overlooking Jakarta'}
        width="1122"
        height="1402"
        class="aspect-[4/5] h-full w-full object-cover reveal-img-breathe"
        loading="eager"
        decoding="async"
      />
    </figure>
  </div>
</section>
