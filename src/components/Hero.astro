---
// Hero.astro - Fullscreen Video Hero with Multi-Language Support
import { getTranslations, type Locale } from '../i18n/translations';

interface Props {
  lang?: Locale;
}

const { lang = 'id' } = Astro.props;
const t = getTranslations(lang);
---

<section class="relative min-h-[100dvh] w-full flex flex-col justify-between overflow-hidden bg-slate-950">
  <!-- 1. Background Video Layer -->
  <div class="absolute inset-0 z-0 hero-parallax-element" data-hero-parallax="0.18">
    <video
      id="hero-video-element"
      autoplay
      loop
      muted
      playsinline
      preload="auto"
      class="w-full h-full object-cover scale-105 transition-transform duration-1000 ease-out"
    >
      <source src="/hero.mp4" type="video/mp4" />
      Browser Anda tidak mendukung pemutar video HTML5.
    </video>

    <!-- Filter Overlay Abu-abu Elegan (Slightly Gray/Slate Opacity Filter) -->
    <div class="absolute inset-0 bg-slate-900/30 pointer-events-none"></div>

    <!-- Soft Gradient Mask di Sisi Kiri untuk Keterbacaan Teks yang Luas -->
    <div class="absolute inset-y-0 left-0 w-full sm:w-4/5 lg:w-3/5 bg-gradient-to-r from-slate-950/65 via-slate-950/30 to-transparent pointer-events-none"></div>

    <!-- Overlay Gradasi Halus Atas & Bawah Berwarna Slate/Abu Gelap -->
    <div class="absolute inset-x-0 top-0 h-44 bg-gradient-to-b from-slate-950/50 via-slate-900/15 to-transparent pointer-events-none"></div>
    <div class="absolute inset-x-0 bottom-0 h-[55%] bg-gradient-to-t from-slate-950/60 via-slate-900/20 to-transparent pointer-events-none"></div>

    <!-- Transisi Halus (Smooth Dissolve) Tipis & Lembut ke Background Utama (#fbfbfc) -->
    <div class="absolute inset-x-0 bottom-0 h-16 sm:h-24 pointer-events-none z-10 hero-transition-gradient"></div>
  </div>

  <!-- Spacer Atas untuk Mengimbangi Floating TopBar -->
  <div class="pt-20 sm:pt-24 lg:pt-28"></div>

  <!-- 2. Content: Headline Display & Sub-narasi (Lebih Besar & Posisinya Naik Lebih ke Atas) -->
  <div class="relative z-20 max-w-7xl mx-auto w-full px-5 sm:px-8 pb-16 sm:pb-36 lg:pb-44">
    <div class="max-w-2xl space-y-4 sm:space-y-5">
      <h1 data-reveal="title" class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl xl:text-[76px] font-medium tracking-[-0.04em] text-white leading-[1.08] font-sans drop-shadow-lg reveal-title-init">
        {t.hero.headlinePart1}<br />{t.hero.headlinePart2}
      </h1>
      <p data-reveal="text" class="text-sm sm:text-base md:text-lg lg:text-xl text-slate-200/90 font-normal leading-relaxed max-w-xl drop-shadow-md reveal-text-init stagger-2">
        {t.hero.subtitle}
      </p>
    </div>
  </div>

  <!-- 3. Scroll Down Mouse Indicator (Centered at Bottom, Fades out on scroll) -->
  <div
    id="hero-scroll-indicator-container"
    class="absolute bottom-6 sm:bottom-8 left-1/2 -translate-x-1/2 z-20 flex flex-col items-center transition-all duration-500 ease-out opacity-100 translate-y-0"
  >
    <a
      href="#services"
      id="hero-scroll-btn"
      class="group flex flex-col items-center gap-2 text-white/70 hover:text-white transition-colors duration-300 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-white/50 rounded-full p-1 cursor-pointer"
      aria-label={lang === 'id' ? 'Gulir ke bawah' : 'Scroll down'}
    >
      <div class="mouse-chassis relative w-[22px] h-[36px] sm:w-[24px] sm:h-[38px] rounded-full border-[1.5px] border-white/60 group-hover:border-white transition-colors duration-300 flex justify-center pt-2">
        <span class="mouse-wheel-dot w-1 h-2 sm:w-1 sm:h-2.5 bg-white rounded-full"></span>
      </div>
    </a>
  </div>
</section>

<script>
  const indicator = document.getElementById('hero-scroll-indicator-container');
  const scrollBtn = document.getElementById('hero-scroll-btn');

  const handleScroll = () => {
    if (!indicator) return;
    if (window.scrollY > 40) {
      indicator.classList.add('opacity-0', 'pointer-events-none', 'translate-y-2');
      indicator.classList.remove('opacity-100', 'translate-y-0');
    } else {
      indicator.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-2');
      indicator.classList.add('opacity-100', 'translate-y-0');
    }
  };

  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();

  if (scrollBtn) {
    scrollBtn.addEventListener('click', (e) => {
      e.preventDefault();
      const nextTarget = document.querySelector('section:nth-of-type(2)') || document.getElementById('services');
      if (nextTarget) {
        nextTarget.scrollIntoView({ behavior: 'smooth' });
      } else {
        window.scrollTo({ top: window.innerHeight, behavior: 'smooth' });
      }
    });
  }
</script>

<style>
  .hero-transition-gradient {
    background: linear-gradient(
      to bottom,
      rgba(251, 251, 252, 0) 0%,
      rgba(251, 251, 252, 0.02) 30%,
      rgba(251, 251, 252, 0.10) 58%,
      rgba(251, 251, 252, 0.30) 78%,
      rgba(251, 251, 252, 0.65) 92%,
      rgba(251, 251, 252, 0.90) 98%,
      #fbfbfc 100%
    );
  }

  .mouse-wheel-dot {
    animation: mouse-wheel-roll 1.8s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  @keyframes mouse-wheel-roll {
    0% {
      opacity: 1;
      transform: translateY(0);
    }
    50% {
      opacity: 0.8;
      transform: translateY(6px);
    }
    100% {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mouse-wheel-dot {
      animation: none;
    }
  }
</style>

