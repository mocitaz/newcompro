---
import { getTranslations, type Locale } from '../i18n/translations';

interface Props {
  lang?: Locale;
}

const { lang = 'id' } = Astro.props;
const t = getTranslations(lang);
const disciplines = t.aiDisciplines.items;
const layananUrl = lang === 'id' ? '/id/layanan' : '/layanan';
---

<section
  id="ai-disciplines"
  aria-label={lang === 'en' ? "Core Engineering & Digital Services" : "Layanan Utama Rekayasa & Platform Digital"}
  class="home-section relative isolate overflow-hidden bg-[#fbfbfc]"
>
  <div class="pointer-events-none absolute inset-0 z-0 overflow-hidden" aria-hidden="true">
    <picture>
      <source srcset="/ai_disciplines_bg_v3.webp" type="image/webp" />
      <img
        src="/ai_disciplines_bg_v3.jpg"
        alt=""
        class="tailored-background-image h-full w-full object-cover object-center opacity-50"
        loading="lazy"
        decoding="async"
      />
    </picture>
    <div class="tailored-background-fade absolute inset-0" />
  </div>

  <div class="home-container relative z-10">
    <!-- Keep the title first on mobile while reversing the desktop columns. -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 lg:gap-14 items-start mb-8 sm:mb-14 reveal-init" data-reveal="title">
    <div class="lg:order-2 lg:col-span-5">
      <h2 class="text-2xl sm:text-3xl lg:text-[2.15rem] font-bold text-slate-950 tracking-[-0.02em] leading-tight font-sans">
        {t.aiDisciplines.headline}
      </h2>
    </div>
    <div class="lg:order-1 lg:col-span-7 flex flex-col items-start gap-3.5 sm:gap-5">
      <p class="text-sm sm:text-base text-slate-600 leading-relaxed font-normal font-sans">
        {t.aiDisciplines.description}
      </p>
      <div>
        <a
          href={layananUrl}
          class="group inline-flex items-center gap-2 text-slate-900 font-semibold text-sm sm:text-base border-b-2 border-slate-900 pb-0.5 hover:text-slate-600 hover:border-slate-600 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400 font-sans cursor-pointer min-h-[44px]"
        >
          <span>{t.aiDisciplines.viewAllCta}</span>
          <svg
            class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-5 lg:grid-cols-4">
    {
      disciplines.map((item, index) => (
        <a
          href={item.href || layananUrl}
          data-reveal="scale"
          class={`group block rounded-[14px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400 focus-visible:ring-offset-4 reveal-scale-init stagger-${(index % 4) + 1}`}
        >
          <picture class="block aspect-[4/5] overflow-hidden rounded-[14px] border border-slate-200 bg-slate-100">
            <source srcset={item.image} type="image/webp" />
            <img
              src={item.fallback}
              alt={item.title}
              class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.02] motion-reduce:transition-none motion-reduce:group-hover:scale-100 reveal-img-breathe"
              loading="lazy"
              decoding="async"
              width="800"
              height="1000"
            />
          </picture>

          <div class="px-0.5 pt-4">
            <h3 class="min-h-[3rem] text-base font-bold leading-snug tracking-tight text-slate-950 transition-colors group-hover:text-slate-600 sm:text-lg">
              {item.title}
            </h3>
          </div>
        </a>
      ))
    }
    </div>
  </div>
</section>

<style>
  .tailored-background-image {
    -webkit-mask-image: radial-gradient(ellipse 98% 82% at 55% 50%, #000 38%, transparent 100%);
    mask-image: radial-gradient(ellipse 98% 82% at 55% 50%, #000 38%, transparent 100%);
  }

  .tailored-background-fade {
    background: linear-gradient(
      to bottom,
      #fbfbfc 0%,
      rgba(251, 251, 252, 0) 22%,
      rgba(251, 251, 252, 0) 78%,
      #fbfbfc 100%
    );
  }
</style>
