---
// src/components/CaseStudiesGrid.astro
// Clean, minimal, compact white Case Studies Grid
import { getTranslations, type Locale } from '../i18n/translations';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = getTranslations(lang);
const page = t.caseStudiesPage;
---

<div class="case-study-hero-wrapper relative w-full bg-white">
  <section class="relative pt-20 sm:pt-28 pb-14 sm:pb-20 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
    <!-- Hero Header Section -->
    <div class="w-full max-w-3xl mx-auto text-center" data-reveal="fade">
      <h1 class="case-study-title text-2xl sm:text-3xl md:text-[38px] font-medium tracking-[-0.035em] text-slate-950 leading-[1.2]">
        {page.hero.title}
      </h1>
      <p class="case-study-subtitle text-xs sm:text-sm md:text-[15px] text-slate-500 leading-relaxed max-w-xl mx-auto mt-2.5 sm:mt-3">
        {page.hero.subtitle}
      </p>
    </div>

    <!-- Case Studies 2-Column Grid (1-Col on Mobile) - Clean Compact Cards -->
    <div
      class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8 lg:gap-8 mt-10 sm:mt-12 w-full"
      id="case-studies-container"
    >
      {page.items.map((item, idx) => (
        <article
          class="case-study-card relative flex flex-col bg-white rounded-[16px] sm:rounded-[20px]"
          data-category={item.category}
          data-reveal="fade"
          class:list={[`stagger-${(idx % 4) + 1}`]}
        >
          <!-- Card Image Container -->
          <div class="relative aspect-[16/9.5] sm:aspect-[16/9] w-full rounded-[14px] sm:rounded-[18px] overflow-hidden bg-slate-100 border border-slate-200/80 shadow-[0_2px_8px_rgba(0,0,0,0.03)]">
            <picture>
              <source srcset={item.webp} type="image/webp" />
              <img
                src={item.image}
                alt={item.alt}
                class="w-full h-full object-cover object-center select-none"
                loading={idx < 2 ? "eager" : "lazy"}
                decoding="async"
                width="1200"
                height="676"
              />
            </picture>
          </div>

          <!-- Content Info Footer -->
          <div class="flex items-start justify-between gap-3 sm:gap-4 mt-3.5 sm:mt-4 px-0.5">
            <div class="min-w-0 flex-1">
              <h2 class="case-study-card-title text-[15px] sm:text-[17px] font-semibold text-slate-950 tracking-tight leading-snug">
                {item.title}
              </h2>
              <p class="case-study-card-desc text-xs sm:text-[13px] text-slate-500 font-normal mt-1 leading-relaxed line-clamp-2">
                {item.subtitle}
              </p>
            </div>

            <!-- Industry Tag -->
            <div class="shrink-0 flex flex-col items-end pt-0.5">
              <span class="text-[10px] font-medium text-slate-400 mb-0.5 font-inter">
                {page.hero.industryLabel}
              </span>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-medium text-slate-600 bg-slate-100 border border-slate-200/70 whitespace-nowrap font-inter">
                {item.industry}
              </span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</div>

<style>
  .case-study-title {
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
  }
  .case-study-subtitle {
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
  }
  .case-study-card-title {
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
  }
  .case-study-card-desc {
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
  }
</style>
