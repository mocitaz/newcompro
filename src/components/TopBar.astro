---
// TopBar.astro - Edge-to-Edge Fixed Enterprise Header with Dynamic Scroll Transition
import { getTranslations, type Locale } from '../i18n/translations';

interface Props {
  lang?: Locale;
}

const currentPath = Astro.url.pathname;
const isIdPath = currentPath === '/id' || currentPath.startsWith('/id/');
const currentLang: Locale = Astro.props.lang || (isIdPath ? 'id' : 'en');
const t = getTranslations(currentLang);

const isHome = currentPath === '/' || currentPath === '' || currentPath === '/id' || currentPath === '/id/';
const isWebDev = currentPath.includes('/website-development');
const isPorto = currentPath.includes('/portofolio') || currentPath.includes('/portfolio');
const isLayanan = currentPath.includes('/layanan') || currentPath.includes('/services');
const isAbout = currentPath.includes('/about') || currentPath.includes('/tentang-kami');

// URLs for current language
const homeUrl = currentLang === 'id' ? '/id' : '/';
const portoUrl = currentLang === 'id' ? '/id/portofolio' : '/portofolio';
const layananUrl = currentLang === 'id' ? '/id/layanan' : '/layanan';
const aboutUrl = currentLang === 'id' ? '/id/tentang-kami' : '/about';
const industriesSectionUrl = isHome ? '#industries' : `${homeUrl}#industries`;

const resolveHref = (href: string) => {
  if (href.startsWith('#')) {
    return isHome ? href : `${homeUrl}${href}`;
  }
  return href;
};

// Alternate language target URLs
let idUrl = '/id';
let enUrl = '/';
if (isWebDev) {
  idUrl = '/id/layanan/website-development';
  enUrl = '/services/website-development';
} else if (isPorto) {
  idUrl = '/id/portofolio';
  enUrl = '/portofolio';
} else if (isLayanan) {
  idUrl = '/id/layanan';
  enUrl = '/layanan';
} else if (isAbout) {
  idUrl = '/id/tentang-kami';
  enUrl = '/about';
} else {
  idUrl = '/id';
  enUrl = '/';
}

const isCurrentId = currentLang === 'id';
const toggleUrl = isCurrentId ? enUrl : idUrl;
const toggleTitle = isCurrentId
  ? "Bahasa Indonesia (Klik untuk switch ke English)"
  : "English (Click to switch to Bahasa Indonesia)";
const toggleAriaLabel = isCurrentId
  ? "Beralih ke Bahasa Inggris"
  : "Switch to Indonesian";
---

<header
  id="main-topbar-header"
  data-is-home={isHome ? "true" : "false"}
  class:list={[
    "fixed top-0 inset-x-0 w-full z-50 transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]",
    !isHome && "scrolled"
  ]}
>
  <div class="relative max-w-7xl mx-auto px-5 sm:px-8 h-16 sm:h-20 flex items-center justify-between">
    <!-- Left: Brand Logo -->
    <div class="flex items-center shrink-0">
      <a
        href={homeUrl}
        class="group inline-flex items-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400 rounded-md py-1"
        aria-label="PT Teknalogi Transformasi Digital Beranda"
      >
        <div class="grid items-center h-7 sm:h-8">
          <!-- Logo Hero: White for dark Hero -->
          <img
            id="brand-logo-hero"
            src="/logo_hero.png"
            alt="Logo PT Teknalogi Transformasi Digital"
            class="[grid-area:1/1] h-7 sm:h-8 w-auto object-contain transition-opacity duration-300 pointer-events-auto"
            loading="eager"
          />

          <!-- Logo Scrolled / Subpage: Official Dark/Purple Logo -->
          <img
            id="brand-logo-scrolled"
            src="/logo.png"
            alt="Logo PT Teknalogi Transformasi Digital"
            class="[grid-area:1/1] h-7 sm:h-8 w-auto object-contain transition-opacity duration-300 pointer-events-none opacity-0"
            loading="eager"
          />
        </div>
      </a>
    </div>

    <!-- Center: Desktop Navigation Routes (Centered on Desktop) -->
    <nav
      class="hidden lg:flex items-center gap-3 xl:gap-6 absolute left-1/2 -translate-x-1/2 h-full"
      aria-label="Navigasi Utama"
    >
      <!-- 1. Tentang Kami -->
      <a
        href={aboutUrl}
        class:list={[
          "desktop-nav-link text-xs lg:text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400 rounded px-2 py-1.5 whitespace-nowrap cursor-pointer",
          isAbout && "font-semibold active-nav-link"
        ]}
      >
        {t.nav.about}
      </a>

      <!-- 2. Industri ▾ (Mega Menu Dropdown) -->
      <div class="static group dropdown-container h-full flex items-center">
        <button
          type="button"
          aria-expanded="false"
          aria-haspopup="true"
          class="desktop-nav-link text-xs lg:text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400 rounded px-2 py-1.5 inline-flex items-center gap-1.5 whitespace-nowrap cursor-pointer select-none"
        >
          <span>{t.nav.industries}</span>
          <svg class="w-3.5 h-3.5 transition-transform duration-200 dropdown-chevron shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Industri Mega Menu Panel -->
        <div class="dropdown-menu absolute top-full left-1/2 w-[calc(100vw-1rem)] max-w-[1760px] z-50">
          <div class="mega-panel bg-[#fbfbfc]/98 backdrop-blur-xl border-x border-b border-slate-200/90 shadow-[0_20px_38px_-30px_rgba(15,23,42,0.38)] rounded-b-2xl p-4 sm:p-5 xl:p-6 text-slate-900 flex items-stretch gap-4 xl:gap-6 transition-[background-color,border-color,box-shadow] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]">
            
            <!-- Left Card: Industri Overview -->
            <div class="mega-overview w-[220px] xl:w-[260px] shrink-0 bg-gradient-to-b from-[#f8fafc] to-[#f1f5f9] rounded-2xl p-4.5 xl:p-5.5 border border-slate-200/70 flex flex-col justify-between shadow-2xs transition-[background-color,border-color] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]">
              <div>
                <h3 class="text-xl xl:text-2xl font-bold text-slate-900 tracking-tight font-sans">
                  {t.nav.industriesMega.title}
                </h3>
                <p class="text-xs xl:text-[13px] text-slate-500 leading-relaxed mt-2 font-normal font-sans">
                  {t.nav.industriesMega.subtitle}
                </p>
              </div>
              <div class="mt-auto border-t border-slate-200/60 pt-4">
                <a
                  href={industriesSectionUrl}
                  class="group/all inline-flex items-center gap-1.5 text-xs font-semibold text-slate-900 transition-colors hover:text-slate-950"
                >
                  <span>{currentLang === 'id' ? 'Lihat Semua Industri' : 'Explore All Industries'}</span>
                  <svg class="h-3.5 w-3.5 transition-transform duration-200 group-hover/all:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </div>

            <!-- Middle Card: Dynamic Image Preview (Changes smoothly on list hover) -->
            <div class="w-[280px] xl:w-[360px] shrink-0 rounded-2xl overflow-hidden relative shadow-sm border border-slate-200/80 bg-slate-900 self-stretch min-h-[250px] xl:min-h-[270px]">
              <div
                data-industry-preview-empty
                class="industry-empty-preview absolute inset-0 z-20 flex flex-col justify-end bg-gradient-to-br from-slate-100 via-slate-50 to-slate-200 p-5 xl:p-6 transition-[opacity,background-color] duration-200"
              >
                <span class="mb-auto text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-500">{currentLang === 'id' ? 'Sektor industri' : 'Industry sectors'}</span>
                <h3 class="max-w-[12rem] text-lg xl:text-xl font-bold tracking-tight text-slate-950">
                  {currentLang === 'id' ? 'Pilih sektor untuk melihat fokus kami.' : 'Select a sector to explore our focus.'}
                </h3>
                <p class="mt-2 max-w-[15rem] text-xs leading-relaxed text-slate-600">
                  {currentLang === 'id' ? 'Setiap sektor memiliki kebutuhan teknologi yang berbeda.' : 'Each sector has a distinct technology and delivery context.'}
                </p>
              </div>
              {t.nav.industriesMega.items.map((item, idx) => (
                <div
                  data-industry-preview={item.id}
                  class="industry-preview-slide absolute inset-0 opacity-0 scale-95 z-0 pointer-events-none transition-all duration-300"
                >
                  <picture class="absolute inset-0 w-full h-full block">
                    <source srcset={item.image} type="image/webp" />
                    <img
                      src={item.fallback}
                      alt={item.title}
                      class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                      loading="lazy"
                    />
                  </picture>
                  <!-- Gradient overlay at bottom with title & arrow -->
                  <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/35 to-transparent flex items-end p-4 xl:p-5">
                    <a
                      href={resolveHref(item.href)}
                      class="text-white text-sm xl:text-base font-bold flex items-center justify-between w-full hover:text-slate-200 transition-colors group/label"
                    >
                      <span>{item.title}</span>
                      <span class="w-6 h-6 xl:w-7 xl:h-7 rounded-full bg-white/20 backdrop-blur-xs flex items-center justify-center text-white group-hover/label:bg-white group-hover/label:text-slate-900 transition-all">
                        <svg class="w-3 h-3 xl:w-3.5 xl:h-3.5 transition-transform duration-200 group-hover/label:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                        </svg>
                      </span>
                    </a>
                  </div>
                </div>
              ))}
            </div>

            <!-- Right Column: Interactive List of All 9 Industries across 2 Columns -->
            <div class="flex-1 grid grid-cols-2 gap-x-3.5 xl:gap-x-5 gap-y-1.5 xl:gap-y-2 content-center border-l border-slate-200/60 pl-4 xl:pl-6">
              {t.nav.industriesMega.items.map((item, idx) => (
                <a
                  href={resolveHref(item.href)}
                  data-industry-trigger={item.id}
                  class="industry-item-link group/ind flex items-center justify-between py-1.5 xl:py-2 px-2.5 xl:px-3 rounded-xl text-slate-800 hover:bg-slate-100 hover:text-slate-950 font-medium transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400 cursor-pointer"
                >
                  <span class="text-xs xl:text-[13px] leading-snug transition-colors">
                    {item.title}
                  </span>
                  <svg
                    class="w-3.5 h-3.5 xl:w-4 xl:h-4 transition-all text-slate-950 shrink-0 opacity-0 -translate-x-1 group-hover/ind:opacity-100 group-hover/ind:translate-x-0"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              ))}
            </div>

          </div>
        </div>
      </div>

      <!-- 3. Layanan ▾ (Mega Menu Dropdown) -->
      <div class="static group dropdown-container h-full flex items-center">
        <button
          type="button"
          aria-expanded="false"
          aria-haspopup="true"
          class="desktop-nav-link text-xs lg:text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400 rounded px-2 py-1.5 inline-flex items-center gap-1.5 whitespace-nowrap cursor-pointer select-none"
        >
          <span>{t.nav.services}</span>
          <svg class="w-3.5 h-3.5 transition-transform duration-200 dropdown-chevron shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Layanan Mega Menu Panel -->
        <div class="dropdown-menu absolute top-full left-1/2 w-[calc(100vw-1rem)] max-w-[1760px] z-50">
          <div class="mega-panel bg-[#fbfbfc]/98 backdrop-blur-xl border-x border-b border-slate-200/90 shadow-[0_20px_38px_-30px_rgba(15,23,42,0.38)] rounded-b-2xl p-5 sm:p-6 xl:p-7 text-slate-900 flex items-stretch gap-5 xl:gap-7 transition-[background-color,border-color,box-shadow] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]">
            
            <!-- Left Card: Layanan & Solusi Overview -->
            <div class="mega-overview w-[230px] xl:w-[270px] shrink-0 bg-gradient-to-b from-[#f8fafc] to-[#f1f5f9] rounded-2xl p-5 xl:p-6 border border-slate-200/70 flex flex-col justify-between shadow-2xs transition-[background-color,border-color] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]">
              <div>
                <h3 class="text-xl xl:text-2xl font-bold text-slate-900 tracking-tight font-sans">
                  {t.nav.servicesMega.title}
                </h3>
                <p class="text-xs xl:text-[13px] text-slate-500 leading-relaxed mt-2.5 font-normal font-sans">
                  {t.nav.servicesMega.subtitle}
                </p>
              </div>

              <div class="mt-auto border-t border-slate-200/60 pt-4">
                <a
                  href={resolveHref(t.nav.servicesMega.ctaHref)}
                  class="group/btn inline-flex items-center gap-1.5 text-xs font-semibold text-slate-900 transition-colors hover:text-slate-950"
                >
                  <span>{t.nav.servicesMega.ctaLabel}</span>
                  <svg class="h-3.5 w-3.5 transition-transform duration-200 group-hover/btn:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </div>

            <!-- Middle Section: 8 Services in 2 Columns of 4 -->
            <div class="flex-1 grid grid-cols-2 gap-x-4 xl:gap-x-7 items-stretch">
              <!-- Column 1: Website, Software, Mobile, Automation -->
              <div class="flex flex-col justify-between space-y-1">
                {t.nav.servicesMega.items.slice(0, 4).map((item) => (
                  <a
                    href={resolveHref(item.href)}
                    class="group/item flex items-start gap-2.5 xl:gap-3.5 p-2 xl:p-2.5 rounded-xl hover:bg-slate-50 transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400"
                  >
                    <span class="w-8 h-8 xl:w-9 xl:h-9 rounded-xl bg-white border border-slate-200/90 shadow-2xs flex items-center justify-center text-slate-700 group-hover/item:text-slate-950 group-hover/item:border-slate-300 group-hover/item:bg-slate-100 transition-colors shrink-0 mt-0.5">
                      {item.icon === 'globe' && (
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3.6 9h16.8M3.6 15h16.8" />
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M11.5 3a17 17 0 000 18M12.5 3a17 17 0 010 18" />
                        </svg>
                      )}
                      {item.icon === 'code' && (
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <rect x="2.5" y="4" width="19" height="13" rx="2" stroke-width="1.8" />
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8.5 8.5L6.5 10.5L8.5 12.5M15.5 8.5L17.5 10.5L15.5 12.5M9 20h6M12 17v3" />
                        </svg>
                      )}
                      {item.icon === 'mobile' && (
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
                        </svg>
                      )}
                      {item.icon === 'workflow' && (
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <rect x="3.5" y="3.5" width="4.5" height="4.5" rx="1" stroke-width="1.8" />
                          <rect x="16" y="3.5" width="4.5" height="4.5" rx="1" stroke-width="1.8" />
                          <rect x="3.5" y="16" width="4.5" height="4.5" rx="1" stroke-width="1.8" />
                          <rect x="16" y="16" width="4.5" height="4.5" rx="1" stroke-width="1.8" />
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5.75 8v8M18.25 8v8M8 5.75h8M8 18.25h8" />
                        </svg>
                      )}
                    </span>
                    <div>
                      <h4 class="text-xs xl:text-[13.5px] font-bold text-slate-900 group-hover/item:text-slate-950 transition-colors leading-snug">
                        {item.title}
                      </h4>
                      <p class="text-[11px] xl:text-xs text-slate-500 leading-relaxed mt-0.5 line-clamp-2">
                        {item.desc}
                      </p>
                    </div>
                  </a>
                ))}
              </div>

              <!-- Column 2: SEO, AI Search, Audit, Maintenance -->
              <div class="flex flex-col justify-between space-y-1">
                {t.nav.servicesMega.items.slice(4, 8).map((item) => (
                  <a
                    href={resolveHref(item.href)}
                    class="group/item flex items-start gap-2.5 xl:gap-3.5 p-2 xl:p-2.5 rounded-xl hover:bg-slate-50 transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400"
                  >
                    <span class="w-8 h-8 xl:w-9 xl:h-9 rounded-xl bg-white border border-slate-200/90 shadow-2xs flex items-center justify-center text-slate-700 group-hover/item:text-slate-950 group-hover/item:border-slate-300 group-hover/item:bg-slate-100 transition-colors shrink-0 mt-0.5">
                      {item.icon === 'search' && (
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 5a2 2 0 012-2h14a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V5z" />
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 9h18M14 14l3.5 3.5M16 13a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z" />
                        </svg>
                      )}
                      {item.icon === 'ai-search' && (
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <circle cx="10.5" cy="10.5" r="7.5" stroke-width="1.8" />
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 16l4.5 4.5M12 10.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zm0 0v1a1.2 1.2 0 002.4 0v-1a2.4 2.4 0 00-4.8 0" />
                        </svg>
                      )}
                      {item.icon === 'audit' && (
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 3H5a2 2 0 00-2 2v14a2 2 0 002 2h9m-5-18a2 2 0 012-2h2a2 2 0 012 2m-6 0h6m-6 5h5m-5 4h3" />
                          <circle cx="16.5" cy="16.5" r="3.5" stroke-width="1.8" />
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 19l2.5 2.5" />
                        </svg>
                      )}
                      {item.icon === 'maintenance' && (
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 5a2 2 0 012-2h14a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V5z" />
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 9h18M11.5 13.5l2-2a1.414 1.414 0 012 2l-2 2m-2-2l-1.5 1.5" />
                        </svg>
                      )}
                    </span>
                    <div>
                      <h4 class="text-xs xl:text-[13.5px] font-bold text-slate-900 group-hover/item:text-slate-950 transition-colors leading-snug">
                        {item.title}
                      </h4>
                      <p class="text-[11px] xl:text-xs text-slate-500 leading-relaxed mt-0.5 line-clamp-2">
                        {item.desc}
                      </p>
                    </div>
                  </a>
                ))}
              </div>
            </div>

            <!-- Right Column: Solusi Unggulan -->
            <div class="w-[220px] xl:w-[260px] shrink-0 border-l border-slate-200/80 pl-4 xl:pl-6 flex flex-col justify-between">
              <div>
                <h4 class="text-xs xl:text-sm font-bold text-slate-900 tracking-tight font-sans">
                  {t.nav.servicesMega.featuredSolutions.title}
                </h4>
                <p class="text-[11px] xl:text-xs text-slate-500 leading-relaxed mt-1 mb-3">
                  {t.nav.servicesMega.featuredSolutions.desc}
                </p>
                <div class="space-y-1">
                  {t.nav.servicesMega.featuredSolutions.solutions.map((sol) => (
                    <a
                      href={resolveHref(sol.href)}
                      class="group/sol block text-xs text-slate-800 hover:text-slate-950 font-medium transition-colors py-1 px-2 -mx-2 rounded-lg hover:bg-slate-100 flex items-center justify-between"
                    >
                      <span>{sol.label}</span>
                      <svg class="w-3 h-3 text-slate-400 opacity-0 -translate-x-1 group-hover/sol:opacity-100 group-hover/sol:translate-x-0 group-hover/sol:text-slate-950 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                      </svg>
                    </a>
                  ))}
                </div>
              </div>

              <!-- CTA Button -->
              <div class="pt-5 mt-auto">
                <a
                  href={resolveHref(t.nav.servicesMega.featuredSolutions.ctaHref)}
                  class="w-full inline-flex items-center justify-between px-3.5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold transition-all duration-200 shadow-2xs group/btn"
                >
                  <span>{t.nav.servicesMega.featuredSolutions.ctaLabel}</span>
                  <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover/btn:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </div>

          </div>
        </div>
      </div>

      <!-- 4. Resources ▾ (Mega Menu Dropdown) -->
