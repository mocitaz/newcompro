---
// src/components/services/SeoFeatures.astro
import { getTranslations, type Locale } from '../../i18n/translations';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = getTranslations(lang);
const features = t.seoService.features;
---

<section
  id="what-we-deliver"
  aria-label={features.title}
  class="relative isolate bg-white py-12 sm:py-20 lg:py-28"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header Centered -->
    <div class="max-w-3xl mx-auto text-center mb-8 sm:mb-14 lg:mb-20 reveal-init" data-reveal="title">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-medium text-slate-950 tracking-[-0.04em] font-sans leading-tight">
        {features.title}
      </h2>
      <p class="mt-3 sm:mt-4 text-sm sm:text-base text-slate-600 leading-relaxed font-normal font-sans max-w-2xl mx-auto">
        {features.subtitle}
      </p>
    </div>

    <!-- 3-Column Compact Editorial Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 items-stretch">
      {features.items.map((item, index) => {
        const rowIndex = Math.floor(index / 3);
        return (
          <div
            data-reveal="scale"
            class={`feature-card feature-row-${rowIndex} feature-card-${index} group relative flex min-h-0 sm:min-h-[17.5rem] flex-col justify-between overflow-hidden rounded-[20px] border border-slate-200/85 bg-white p-5 sm:p-7 reveal-scale-init stagger-${(index % 3) + 1}`}
          >
            <!-- Top Bar: Icon at Top Left -->
            <div class="relative z-10 flex items-start justify-between">
              <span class="w-8 h-8 sm:w-9 sm:h-9 text-slate-900 flex items-center justify-center" aria-hidden="true">
                {item.icon === 'strategy' && (
                  <svg class="w-7 h-7 sm:w-8 sm:h-8 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="12" cy="12" r="10" />
                    <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" />
                  </svg>
                )}
                {item.icon === 'content' && (
                  <svg class="w-7 h-7 sm:w-8 sm:h-8 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <polyline points="14 2 14 8 20 8" />
                    <line x1="16" y1="13" x2="8" y2="13" />
                    <line x1="16" y1="17" x2="8" y2="17" />
                    <polyline points="10 9 9 9 8 9" />
                  </svg>
                )}
                {item.icon === 'ai-readiness' && (
                  <svg class="w-7 h-7 sm:w-8 sm:h-8 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M12 2v4m0 12v4M2 12h4m12 0h4" />
                    <circle cx="12" cy="12" r="4" />
                    <path d="m4.93 4.93 2.83 2.83m8.48 8.48 2.83 2.83M4.93 19.07l2.83-2.83m8.48-8.48 2.83-2.83" />
                  </svg>
                )}
                {item.icon === 'research' && (
                  <svg class="w-7 h-7 sm:w-8 sm:h-8 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="11" cy="11" r="8" />
                    <line x1="21" y1="21" x2="16.65" y2="16.65" />
                    <path d="M11 8v6M8 11h6" />
                  </svg>
                )}
                {item.icon === 'authority' && (
                  <svg class="w-7 h-7 sm:w-8 sm:h-8 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="12" cy="8" r="7" />
                    <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88" />
                  </svg>
                )}
                {item.icon === 'conversion' && (
                  <svg class="w-7 h-7 sm:w-8 sm:h-8 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <polyline points="23 6 13.5 15.5 8.5 10.5 1 18" />
                    <polyline points="17 6 23 6 23 12" />
                  </svg>
                )}
                {item.icon === 'technical' && (
                  <svg class="w-7 h-7 sm:w-8 sm:h-8 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <polyline points="16 18 22 12 16 6" />
                    <polyline points="8 6 2 12 8 18" />
                    <line x1="10" y1="20" x2="14" y2="4" />
                  </svg>
                )}
                {item.icon === 'monitoring' && (
                  <svg class="w-7 h-7 sm:w-8 sm:h-8 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
                  </svg>
                )}
                {item.icon === 'solutions' && (
                  <svg class="w-7 h-7 sm:w-8 sm:h-8 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="3" y="3" width="7" height="7" />
                    <rect x="14" y="3" width="7" height="7" />
                    <rect x="14" y="14" width="7" height="7" />
                    <rect x="3" y="14" width="7" height="7" />
                  </svg>
                )}
              </span>
            </div>

            <!-- Content Area at Bottom of Card -->
            <div class="relative z-10 mt-auto pt-4 sm:pt-6">
              <h3 class="text-lg sm:text-[21px] font-semibold tracking-[-0.025em] text-slate-950 font-sans leading-snug">
                {item.title}
              </h3>
              <p class="mt-2 text-xs sm:text-[13.5px] leading-relaxed text-slate-600 font-normal font-sans">
                {item.desc}
              </p>
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>

<style>
  .feature-card {
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 300ms cubic-bezier(0.16, 1, 0.3, 1), border-color 300ms ease;
  }

  .feature-card:hover {
    border-color: rgba(203, 213, 225, 0.9);
    transform: translateY(-3px);
    box-shadow: 0 16px 36px -8px rgba(0, 0, 0, 0.07);
  }

  /* Multi-spectrum Ambient Glow */
  .feature-card::before {
    position: absolute;
    top: -2.5rem;
    right: -2rem;
    z-index: 0;
    height: 12rem;
    width: 12rem;
    border-radius: 9999px;
    pointer-events: none;
    opacity: 0.85;
    transition: opacity 300ms ease, transform 300ms ease;
    content: "";
  }

  .feature-card:hover::before {
    opacity: 1;
    transform: scale(1.08);
  }

  /* Row 0: Sunset Peach / Amber glow */
  .feature-row-0::before {
    background: radial-gradient(circle at 100% 0%, rgba(254, 215, 170, 0.45) 0%, rgba(253, 186, 116, 0.2) 40%, rgba(255, 255, 255, 0) 70%);
  }

  /* Row 1: Cyan / Turquoise glow */
  .feature-row-1::before {
    background: radial-gradient(circle at 100% 0%, rgba(165, 243, 252, 0.45) 0%, rgba(103, 232, 249, 0.2) 40%, rgba(255, 255, 255, 0) 70%);
  }

  /* Row 2: Violet / Cobalt glow */
  .feature-row-2::before {
    background: radial-gradient(circle at 100% 0%, rgba(199, 210, 254, 0.45) 0%, rgba(165, 180, 252, 0.2) 40%, rgba(255, 255, 255, 0) 70%);
  }
</style>
