---
// src/components/services/AiSearchFeatures.astro
import { getTranslations, type Locale } from '../../i18n/translations';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = getTranslations(lang);
const features = t.aiSearchService.features;
---

<section
  id="what-we-deliver"
  aria-label={features.headline}
  class="relative isolate bg-white py-12 sm:py-20 lg:py-28"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header Centered -->
    <div class="max-w-3xl mx-auto text-center mb-8 sm:mb-14 lg:mb-20 reveal-init" data-reveal="title">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-medium text-slate-950 tracking-[-0.04em] font-sans leading-tight">
        {features.headline}
      </h2>
      <p class="mt-3 sm:mt-4 text-sm sm:text-base text-slate-600 leading-relaxed font-normal font-sans max-w-2xl mx-auto">
        {features.subheadline}
      </p>
    </div>

    <!-- 3-Column Compact Editorial Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 items-stretch">
      {features.items.map((item, index) => {
        const rowIndex = Math.floor(index / 3);
        return (
          <div
            data-reveal="scale"
            class={`feature-card feature-row-${rowIndex} feature-card-${index} group relative flex min-h-0 sm:min-h-[17.5rem] flex-col justify-between overflow-hidden rounded-[20px] border border-slate-200/85 bg-white p-5 sm:p-7 reveal-scale-init stagger-${(index % 3) + 1}`}
          >
            <!-- Top Bar: Icon at Top Left -->
            <div class="relative z-10 flex items-start justify-between">
              <span class="w-8 h-8 sm:w-9 sm:h-9 text-slate-900 flex items-center justify-center" aria-hidden="true">
                {item.icon === 'strategy' && (
                  <svg class="w-7 h-7 sm:w-8 sm:h-8 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="12" cy="12" r="10" />
                    <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" />
                  </svg>
                )}
                {item.icon === 'entity' && (
                  <svg class="w-7 h-7 sm:w-8 sm:h-8 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                    <path d="m9 12 2 2 4-4" />
                  </svg>
                )}
                {item.icon === 'monitoring' && (
                  <svg class="w-7 h-7 sm:w-8 sm:h-8 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
                  </svg>
                )}
                {item.icon === 'aeo' && (
                  <svg class="w-7 h-7 sm:w-8 sm:h-8 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                    <path d="M9 10h6m-6 3h4" />
                  </svg>
                )}
                {item.icon === 'content' && (
                  <svg class="w-7 h-7 sm:w-8 sm:h-8 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <polyline points="14 2 14 8 20 8" />
                    <line x1="16" y1="13" x2="8" y2="13" />
                    <line x1="16" y1="17" x2="8" y2="17" />
                    <polyline points="10 9 9 9 8 9" />
                  </svg>
                )}
                {item.icon === 'synthesis' && (
                  <svg class="w-7 h-7 sm:w-8 sm:h-8 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="18" cy="5" r="3" />
                    <circle cx="6" cy="12" r="3" />
                    <circle cx="18" cy="19" r="3" />
                    <line x1="8.59" y1="13.51" x2="15.42" y2="17.49" />
                    <line x1="15.41" y1="6.51" x2="8.59" y2="10.49" />
                  </svg>
                )}
                {item.icon === 'geo' && (
                  <svg class="w-7 h-7 sm:w-8 sm:h-8 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M12 2v4m0 12v4M2 12h4m12 0h4" />
                    <circle cx="12" cy="12" r="4" />
                    <path d="m4.93 4.93 2.83 2.83m8.48 8.48 2.83 2.83M4.93 19.07l2.83-2.83m8.48-8.48 2.83-2.83" />
                  </svg>
                )}
                {item.icon === 'technical' && (
                  <svg class="w-7 h-7 sm:w-8 sm:h-8 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <polyline points="16 18 22 12 16 6" />
                    <polyline points="8 6 2 12 8 18" />
                    <line x1="10" y1="20" x2="14" y2="4" />
                  </svg>
                )}
                {item.icon === 'authority' && (
                  <svg class="w-7 h-7 sm:w-8 sm:h-8 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="12" cy="8" r="7" />
                    <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88" />
                  </svg>
                )}
              </span>
            </div>

            <!-- Content Area at Bottom of Card -->
            <div class="relative z-10 mt-auto pt-4 sm:pt-6">
              <h3 class="text-lg sm:text-[21px] font-semibold tracking-[-0.025em] text-slate-950 font-sans leading-snug">
                {item.title}
              </h3>
              <p class="mt-2 text-xs sm:text-[13.5px] leading-relaxed text-slate-600 font-normal font-sans">
                {item.desc}
              </p>
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>

<style>
  .feature-card {
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 300ms cubic-bezier(0.16, 1, 0.3, 1), border-color 300ms ease;
  }

  .feature-card:hover {
    border-color: rgba(203, 213, 225, 0.9);
    transform: translateY(-3px);
    box-shadow: 0 16px 36px -8px rgba(0, 0, 0, 0.07);
  }

  /* Multi-spectrum Ambient Glow */
  .feature-card::before {
    position: absolute;
    top: -2.5rem;
    right: -2rem;
    z-index: 0;
    width: 14.5rem;
    height: 14.5rem;
    border-radius: 9999px;
    content: '';
    filter: blur(28px);
    pointer-events: none;
    transition: transform 400ms cubic-bezier(0.16, 1, 0.3, 1), opacity 400ms ease;
  }

  .feature-card:hover::before {
    transform: scale(1.08);
    opacity: 0.95;
  }

  /* 3 Harmonious Colors: 1 Color Theme per Row */

  /* Row 1 (Cards 0, 1, 2): Color 1 - Warm Sunset Peach & Terracotta */
  .feature-row-0::before,
  .feature-card-0::before,
  .feature-card-1::before,
  .feature-card-2::before {
    background: 
      radial-gradient(circle at 62% 35%, rgba(249, 115, 22, 0.42) 0%, rgba(254, 215, 170, 0.20) 38%, transparent 68%),
      radial-gradient(circle at 82% 28%, rgba(251, 146, 60, 0.48) 0%, rgba(255, 237, 213, 0.28) 35%, transparent 72%);
  }

  /* Row 2 (Cards 3, 4, 5): Color 2 - Royal Indigo & Violet */
  .feature-row-1::before,
  .feature-card-3::before,
  .feature-card-4::before,
  .feature-card-5::before {
    background: 
      radial-gradient(circle at 62% 35%, rgba(99, 102, 241, 0.48) 0%, rgba(224, 231, 255, 0.20) 38%, transparent 68%),
      radial-gradient(circle at 82% 28%, rgba(139, 92, 246, 0.52) 0%, rgba(237, 233, 254, 0.28) 35%, transparent 72%);
  }

  /* Row 3 (Cards 6, 7, 8): Color 3 - Midnight Slate & Deep Cobalt */
  .feature-row-2::before,
  .feature-card-6::before,
  .feature-card-7::before,
  .feature-card-8::before {
    background: 
      radial-gradient(circle at 62% 35%, rgba(59, 130, 246, 0.48) 0%, rgba(219, 234, 254, 0.20) 38%, transparent 68%),
      radial-gradient(circle at 82% 28%, rgba(71, 85, 105, 0.45) 0%, rgba(241, 245, 249, 0.28) 35%, transparent 72%);
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-card {
      transition: none;
    }

    .feature-card:hover {
      transform: none;
    }

    .feature-card::before {
      transition: none;
    }

    .feature-card:hover::before {
      transform: none;
    }
  }
</style>
