---
// src/pages/id/layanan/website-development.astro
import Layout from "../../../layouts/Layout.astro";
import TopBar from "../../../components/TopBar.astro";
import WebDevHero from "../../../components/services/WebDevHero.astro";
import WebDevFeatures from "../../../components/services/WebDevFeatures.astro";
import WebDevAboutService from "../../../components/services/WebDevAboutService.astro";
import WebDevFaq from "../../../components/services/WebDevFaq.astro";
import LetsTalk from "../../../components/LetsTalk.astro";
import BackToTop from "../../../components/BackToTop.astro";
import { getTranslations } from "../../../i18n/translations";

const lang = "id";
const t = getTranslations(lang);
const meta = t.webDevService.meta;
---

<Layout
  lang={lang}
  title={meta.title}
  description={meta.description}
>
  <TopBar lang={lang} />
  
  <main id="main-content" class="min-h-screen bg-[#fbfbfc]">
    <!-- Hero Section (Screenshot 1 reference: Frosted Card + 3D Sphere + Quick Links) -->
    <WebDevHero lang={lang} />

    <!-- Core Features Section (Screenshot 2 reference: Concentric Ring Cards) -->
    <WebDevFeatures lang={lang} />

    <!-- In-Depth Editorial Article with Sticky Table of Contents (Reference Screenshot) -->
    <WebDevAboutService lang={lang} />

    <!-- Service Specific FAQ Accordion -->
    <WebDevFaq lang={lang} />

    <!-- Contact CTA Banner -->
    <LetsTalk lang={lang} />
  </main>

  <BackToTop label="Kembali ke atas" />
</Layout>
