---
// src/pages/id/layanan/mobile-app-development.astro
import Layout from "../../../layouts/Layout.astro";
import TopBar from "../../../components/TopBar.astro";
import MobileDevHero from "../../../components/services/MobileDevHero.astro";
import MobileDevFeatures from "../../../components/services/MobileDevFeatures.astro";
import MobileDevAboutService from "../../../components/services/MobileDevAboutService.astro";
import MobileDevFaq from "../../../components/services/MobileDevFaq.astro";
import LetsTalk from "../../../components/LetsTalk.astro";
import BackToTop from "../../../components/BackToTop.astro";
import { getTranslations } from "../../../i18n/translations";

const lang = "id";
const t = getTranslations(lang);
const meta = t.mobileDevService.meta;
---

<Layout
  lang={lang}
  title={meta.title}
  description={meta.description}
>
  <TopBar lang={lang} />
  
  <main id="main-content" class="min-h-screen bg-[#fbfbfc]">
    <!-- Hero Section with Frosted Card & 3D Architectural Disk -->
    <MobileDevHero lang={lang} />

    <!-- Core Capabilities Features Section -->
    <MobileDevFeatures lang={lang} />

    <!-- Editorial Article with Sticky & Mobile Table of Contents -->
    <MobileDevAboutService lang={lang} />

    <!-- Service Specific FAQ Accordion -->
    <MobileDevFaq lang={lang} />

    <!-- Contact CTA Banner -->
    <LetsTalk lang={lang} />
  </main>

  <BackToTop label="Kembali ke atas" />
</Layout>
