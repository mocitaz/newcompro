---
// src/components/services/WebMaintenanceFeatures.astro
import { getTranslations, type Locale } from '../../i18n/translations';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = getTranslations(lang);
const features = t.webMaintenanceService.features;
---

<section
  id="what-we-deliver"
  aria-label={features.title}
  class="relative isolate bg-white py-12 sm:py-20 lg:py-28"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header Centered -->
    <div class="max-w-3xl mx-auto text-center mb-8 sm:mb-14 lg:mb-20 reveal-init" data-reveal="title">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-medium text-slate-950 tracking-[-0.04em] font-sans leading-tight">
        {features.title}
      </h2>
      <p class="mt-3 sm:mt-4 text-sm sm:text-base text-slate-600 leading-relaxed font-normal font-sans max-w-2xl mx-auto">
        {features.subtitle}
      </p>
    </div>

    <!-- 3-Column Compact Editorial Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 items-stretch">
      {features.items.map((item, index) => {
        const rowIndex = Math.floor(index / 3);
        return (
          <div
            data-reveal="scale"
            class={`feature-card feature-row-${rowIndex} feature-card-${index} group relative flex min-h-0 sm:min-h-[17.5rem] flex-col justify-between overflow-hidden rounded-[20px] border border-slate-200/85 bg-white p-5 sm:p-7 reveal-scale-init stagger-${(index % 3) + 1}`}
          >
            <!-- Top Bar: Icon at Top Left -->
            <div class="relative z-10 flex items-start justify-between">
              <span class="w-8 h-8 sm:w-9 sm:h-9 text-slate-900 flex items-center justify-center" aria-hidden="true">
                {item.icon === 'proactive-monitoring' && (
                  <svg class="w-7 h-7 sm:w-8 sm:h-8 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
                  </svg>
                )}
                {item.icon === 'backup-recovery' && (
                  <svg class="w-7 h-7 sm:w-8 sm:h-8 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                    <polyline points="7 10 12 15 17 10" />
                    <line x1="12" y1="15" x2="12" y2="3" />
                  </svg>
                )}
                {item.icon === 'incident-response' && (
                  <svg class="w-7 h-7 sm:w-8 sm:h-8 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                  </svg>
                )}
                {item.icon === 'security-patching' && (
                  <svg class="w-7 h-7 sm:w-8 sm:h-8 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                  </svg>
                )}
                {item.icon === 'bug-resolution' && (
                  <svg class="w-7 h-7 sm:w-8 sm:h-8 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="8" y="9" width="8" height="10" rx="4" />
                    <path d="M6 13h2m8 0h2m-10 4h1.5m7 0H18M9 6.5 7.5 5m7.5 1.5 1.5-1.5" />
                    <line x1="12" y1="9" x2="12" y2="5" />
                  </svg>
                )}
                {item.icon === 'continuous-modernization' && (
                  <svg class="w-7 h-7 sm:w-8 sm:h-8 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <polyline points="23 4 23 10 17 10" />
                    <polyline points="1 20 1 14 7 14" />
                    <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15" />
                  </svg>
                )}
                {item.icon === 'performance-optimization' && (
                  <svg class="w-7 h-7 sm:w-8 sm:h-8 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="12" cy="12" r="10" />
                    <polyline points="12 6 12 12 16 14" />
                  </svg>
                )}
                {item.icon === 'technical-seo' && (
                  <svg class="w-7 h-7 sm:w-8 sm:h-8 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <polyline points="16 18 22 12 16 6" />
                    <polyline points="8 6 2 12 8 18" />
                    <line x1="10" y1="20" x2="14" y2="4" />
                  </svg>
                )}
                {item.icon === 'software-updates' && (
                  <svg class="w-7 h-7 sm:w-8 sm:h-8 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M12 2v4m0 12v4M2 12h4m12 0h4" />
                    <circle cx="12" cy="12" r="4" />
                    <path d="m4.93 4.93 2.83 2.83m8.48 8.48 2.83 2.83M4.93 19.07l2.83-2.83m8.48-8.48 2.83-2.83" />
                  </svg>
                )}
              </span>
            </div>

            <!-- Content Area at Bottom of Card -->
            <div class="relative z-10 mt-auto pt-4 sm:pt-6">
              <h3 class="text-lg sm:text-[21px] font-semibold tracking-[-0.025em] text-slate-950 font-sans leading-snug">
                {item.title}
              </h3>
              <p class="mt-2 text-xs sm:text-[13.5px] leading-relaxed text-slate-600 font-normal font-sans">
                {item.desc}
              </p>
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>

<style>
  .feature-card {
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 300ms cubic-bezier(0.16, 1, 0.3, 1), border-color 300ms ease;
  }

  .feature-card:hover {
    border-color: rgba(203, 213, 225, 0.9);
    transform: translateY(-3px);
    box-shadow: 0 16px 36px -8px rgba(0, 0, 0, 0.07);
  }

  /* Multi-spectrum Ambient Glow */
  .feature-card::before {
    position: absolute;
    top: -2.5rem;
    right: -2rem;
    z-index: 0;
    height: 12rem;
    width: 12rem;
    border-radius: 9999px;
    pointer-events: none;
    opacity: 0.85;
    transition: opacity 300ms ease, transform 300ms ease;
    content: "";
  }

  .feature-card:hover::before {
    opacity: 1;
    transform: scale(1.08);
  }

  /* 3 Distinct Spectrum Glows: 1 completely different color family per row */

  /* Row 0 (Cards 0, 1, 2): Cool Vivid Emerald & Sage */
  .feature-row-0::before,
  .feature-card-0::before,
  .feature-card-1::before,
  .feature-card-2::before {
    background: radial-gradient(circle at 65% 30%, rgba(16, 185, 129, 0.45) 0%, rgba(52, 211, 153, 0.26) 38%, transparent 70%);
  }

  /* Row 1 (Cards 3, 4, 5): Electric Cyan & Sky Teal */
  .feature-row-1::before,
  .feature-card-3::before,
  .feature-card-4::before,
  .feature-card-5::before {
    background: radial-gradient(circle at 65% 30%, rgba(6, 182, 212, 0.45) 0%, rgba(14, 165, 233, 0.26) 38%, transparent 70%);
  }

  /* Row 2 (Cards 6, 7, 8): Royal Indigo & Deep Slate */
  .feature-row-2::before,
  .feature-card-6::before,
  .feature-card-7::before,
  .feature-card-8::before {
    background: radial-gradient(circle at 65% 30%, rgba(99, 102, 241, 0.48) 0%, rgba(129, 140, 248, 0.30) 38%, transparent 70%);
  }
</style>
