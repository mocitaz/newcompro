---
// src/components/industries/BusinessServicesIndustry.astro
import type { Locale } from '../../i18n/translations';
import BusinessServicesAboutIndustry from './BusinessServicesAboutIndustry.astro';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const isId = lang === 'id';

const copy = isId
  ? {
      eyebrow: 'LAYANAN BISNIS & PROFESIONAL',
      title: 'Engineering untuk operasi layanan profesional dan interaksi klien terpadu.',
      lead: 'Bangun dan modernisasi portal klien interaktif, otomasi penagihan berbasis waktu proyek, penjadwalan alokasi konsultan, dan pipeline alur kerja kontrak digital. Teknalogi menghadirkan rekayasa perangkat lunak operasi B2B yang andal dan terukur.',
      primaryCta: 'Diskusikan kebutuhan bisnis Anda',
      challengesTitle: 'Ketika operasi klien terpisah, efisiensi penagihan bocor.',
      challengesLead: 'Operasional melambat saat timesheet, milestone proyek, dan invoice klien berjalan sendiri-sendiri.',
      challenges: [
        ['Komunikasi klien tercecer', 'Dokumen proyek dan revisi pekerjaan hilang di utas email yang terpisah.'],
        ['Kebocoran jam kerja tertagih', 'Pencatatan timesheet manual memperlambat penagihan dan memicu unbilled hours.'],
        ['Kapasitas tim tidak terpantau', 'Ketiadaan visibilitas beban kerja memicu kelebihan beban dan jadwal molor.'],
        ['Persetujuan kontrak lambat', 'Penyusunan dan review perjanjian hukum manual menunda kickoff proyek klien.'],
      ],
      solutionsTitle: 'Solusi perangkat lunak terintegrasi untuk firma konsultan, agensi, dan penyedia jasa korporat.',
      solutionsLead: 'Ruang lingkup sistem disesuaikan dengan tata kelola praktik bisnis Anda, mulai dari ekstranet klien bermerek, mesin kalkulasi tarif multi-tier, hingga integrasi buku besar akuntansi.',
      solutions: [
        ['Portal Klien & Ekstranet Interaktif', 'Ekstranet bermerek khusus untuk review milestone proyek, pertukaran berkas aman, dan persetujuan mandiri.', 'portal'],
        ['Otomasi Timesheet & Billing Proyek', 'Mesin penagihan jam kerja, milestone, dan retainer otomatis dengan kalkulasi pajak dan reimbursable expense.', 'billing'],
        ['Manajemen Kapasitas & Utilisasi Tim', 'Proyeksi beban kerja konsultan real-time, pencocokan keahlian staf, dan matriks utilisasi tim.', 'scheduling'],
        ['Otomasi Kontrak & e-Signature (CLM)', 'Penyusunan klausul dinamis, riwayat revisi berversi, dan penandatanganan elektronik tersertifikasi.', 'contract'],
        ['Repositori Pengetahuan & Aset Digital', 'Pangkalan data metodologi, template proposal, dan aset penelitian dengan hak akses tersegmentasi.', 'knowledge'],
        ['Integrasi ERP & Sistem Keuangan Kantor', 'Sinkronisasi dua arah dengan buku besar akuntansi (Xero/SAP), CRM penjualan, dan perbankan korporasi.', 'integration'],
      ],
      approachTitle: 'Dirancang untuk kerahasiaan data klien dan transparansi operasi bisnis.',
      domains: [
        ['Isolasi Multi-Tenancy & Hak Akses Granular', 'Terapkan perimeter data terisolasi antar-klien untuk menjamin kerahasiaan berkas, kepatuhan NDA, dan audit akses.', 'tenancy'],
        ['Telemetri Utilisasi Tim & Margin Laba Proyek', 'Pantau metrik kapasitas kerja dan tingkat realisasi penagihan (realization rate) secara langsung tanpa jeda.', 'utilization'],
        ['Alur Kerja Persetujuan Status Deterministik', 'Otomatiskan gerbang persetujuan bertingkat guna memastikan deliverable tervalidasi sebelum penagihan termin.', 'workflow'],
      ],
      faqTitle: 'Hal yang biasanya dibahas sebelum proyek layanan bisnis dimulai.',
      faqLead: 'Struktur tarif penagihan, hierarki persetujuan internal, dan standar kepatuhan setiap firma profesional berbeda. Discovery teknis kami memetakan batasan sistem, keamanan data klien, dan alur integrasi.',
      faqTrustTitle: 'Dipercaya oleh',
      faqTrustText: 'Firma profesional, agensi korporat, dan penyedia jasa B2B di Indonesia',
      faqAction: 'Tanyakan kebutuhan bisnis Anda',
      faqs: [
        ['Bisakah portal klien dihubungkan dengan software akuntansi seperti Xero, QuickBooks, atau Jurnal?', 'Ya. Kami membangun antarmuka API dua arah untuk menyinkronkan data kontak klien, draf tagihan invoice yang telah disetujui, dan status pembayaran langsung ke buku besar akuntansi Anda.'],
        ['Bagaimana sistem memastikan kerahasiaan dokumen sensitif antar-klien yang berbeda?', 'Platform kami menerapkan isolasi data logis dan kriptografis (multi-tenant security boundary). Setiap klien hanya dapat melihat berkas proyek mereka sendiri dengan kunci enkripsi terpisah dan pencatatan log audit akses yang ketat.'],
        ['Apakah tanda tangan elektronik pada sistem kontrak dan NDA memiliki kekuatan hukum yang sah?', 'Ya. Modul e-signature kami dapat diintegrasikan dengan Penyelenggara Sertifikasi Elektronik (PSrE) terakreditasi Kominfo (seperti PrivyID, Peruri, BSrE) sehingga dokumen memenuhi kekuatan pembuktian hukum penuh.'],
        ['Bagaimana sistem mengelola skema penagihan gabungan antara retainer bulanan dan jam kerja tambahan?', 'Mesin billing kami mengonfigurasi batas kuota jam kerja retainer secara otomatis. Jam kerja tambahan yang melampaui kuota retainer akan otomatis dialokasikan ke tagihan overage berdasarkan rate card konsultan yang bersangkutan.'],
        ['Bisakah klien eksternal memberikan komentar revisi dan menyetujui deliverable langsung di portal?', 'Bisa. Portal klien dilengkapi fitur preview dokumen interaktif, penambahan catatan revisi berstempel waktu, dan tombol persetujuan digital resmi yang otomatis mengunci versi deliverable.'],
        ['Bagaimana manajer proyek melacak tingkat utilisasi dan pencegahan overbooking konsultan?', 'Sistem kami menyediakan dashboard matriks kapasitas dengan kode warna interaktif yang memperlihatkan alokasi jam kerja setiap konsultan di seluruh proyek aktif secara real-time.'],
        ['Berapa lama waktu implementasi platform operasi bisnis dari tahap discovery hingga peluncuran?', 'Implementasi modular umumnya membutuhkan waktu 6 hingga 12 minggu, mencakup konfigurasi alur kerja, migrasi data historis, integrasi sistem pembayaran/akuntansi, dan pelatihan staf.'],
        ['Apakah Teknalogi menyediakan dukungan pemeliharaan dan kustomisasi alur kerja setelah go-live?', 'Ya. Kami menyediakan layanan pemeliharaan berkelanjutan mencakup pemantauan performa server, pembaruan patch keamanan, audit hak akses berkala, dan penyesuaian modul seiring pertumbuhan firma.'],
      ],
    }
  : {
      eyebrow: 'PROFESSIONAL & BUSINESS SERVICES',
      title: 'Engineering for modern professional services and client operations.',
      lead: 'Build resilient client extranets, automated time-and-billing engines, resource scheduling platforms, and contract workflow pipelines. Teknalogi empowers consulting firms, agencies, and professional practices with high-precision digital operations.',
      primaryCta: 'Discuss your business requirements',
      challengesTitle: 'When client operations disconnect, billable hours leak.',
      challengesLead: 'Operations slow down when timesheets, project milestones, and client invoicing operate in silos.',
      challenges: [
        ['Scattered client communications', 'Project briefs and deliverables get lost across fragmented email threads.'],
        ['Unbilled hours and revenue leakage', 'Manual timesheet tracking delays invoice approvals and causes unbilled fee write-offs.'],
        ['Resource allocation blindspots', 'Lack of real-time capacity visibility triggers team burnout and delivery bottlenecks.'],
        ['Slow contract execution', 'Manual drafting and compliance reviews delay client onboarding and project kickoffs.'],
      ],
      solutionsTitle: 'Integrated software solutions engineered for consultancies, agencies, and corporate practices.',
      solutionsLead: 'System architectures are custom-tailored to your practice governance, spanning secure branded client extranets, multi-tier billing engines, and general ledger financial integrations.',
      solutions: [
        ['Interactive Client Portals & Extranets', 'Dedicated branded extranets for milestone reviews, encrypted file sharing, and self-service approval sign-offs.', 'portal'],
        ['Automated Time, Retainer & Billing Engines', 'Multi-currency hourly, milestone, and retainer invoicing engines with automated tax and expense pass-through.', 'billing'],
        ['Resource Scheduling & Utilization Engine', 'Real-time consultant workload forecasting, skills-based matchmaking, and utilization rate heatmaps.', 'scheduling'],
        ['Digital Contract & NDA Lifecycle Automation', 'Dynamic clause generation, version-controlled audit trails, and certified cryptographic digital signatures.', 'contract'],
        ['Secure Knowledge & IP Repositories', 'Granular role-based knowledge bases for practice templates, methodology frameworks, and research assets.', 'knowledge'],
        ['Unified Practice Management & ERP Bridging', 'Bidirectional data synchronization with corporate accounting (QuickBooks, Xero, SAP) and CRM pipelines.', 'integration'],
      ],
      approachTitle: 'Designed for client confidentiality and operational business clarity.',
      domains: [
        ['Granular RBAC & Client Multi-Tenancy', 'Enforce strict tenant data boundaries ensuring client confidentiality, NDA compliance, and audited access controls.', 'tenancy'],
        ['Real-Time Utilization & Revenue Telemetry', 'Live utilization metrics calculating project profit margins and consultant billable efficiency in real time.', 'utilization'],
        ['Deterministic State Workflows & Approvals', 'Automated sign-off pipelines preventing milestone delivery until mandatory compliance checklists are verified.', 'workflow'],
      ],
      faqTitle: 'What teams usually discuss before a business services project starts.',
      faqLead: 'Billing structures, approval hierarchies, and compliance standards vary across professional practices. Technical discovery maps data boundaries, client privacy controls, and integration workflows.',
      faqTrustTitle: 'Trusted by',
      faqTrustText: 'Consulting practices, corporate agencies, and B2B service firms across Indonesia',
      faqAction: 'Ask about your business requirements',
      faqs: [
        ['Can the client portal integrate with existing accounting software like Xero, QuickBooks, or SAP?', 'Yes. We engineer secure bi-directional APIs to synchronize approved billing drafts, client payment settlements, and expense items directly with your firm’s general ledger.'],
        ['How does the platform enforce document confidentiality across competing enterprise clients?', 'Our architecture enforces rigorous logical and cryptographic multi-tenant separation. Each client’s engagement files are encrypted with dedicated keys and protected by strict role-based access logs.'],
        ['Are digital signatures executed on contracts and NDAs legally binding in Indonesia?', 'Yes. Our contract workflow integrates with licensed Electronic Certification Authorities (PSrE under Kominfo/BSrE) ensuring full legal standing and evidentiary validity under Indonesian electronic transaction laws.'],
        ['How does the system handle hybrid retainer agreements with hourly overage billing?', 'Our billing engine continuously monitors monthly retainer consumption thresholds and automatically routes billable overage hours into invoice drafts according to assigned consultant rate cards.'],
        ['Can external client stakeholders annotate deliverables and sign off directly in the portal?', 'Yes. The portal provides interactive file previewing, timestamped revision annotation tools, and formal cryptographic deliverable approval buttons that permanently lock approved milestones.'],
        ['How do practice leaders track consultant billable utilization and prevent overbooking?', 'The platform features interactive capacity heatmaps that cross-reference forward-looking project allocations against actual timesheet logs to highlight team bandwidth in real time.'],
        ['What is the typical deployment timeline for a professional practice operations platform?', 'A phased implementation typically spans 6 to 12 weeks, encompassing workflow configuration, historical data migration, billing gateway setup, and role-based staff onboarding.'],
        ['Does Teknalogi provide long-term maintenance and custom workflow evolution after launch?', 'Yes. We provide comprehensive managed services including infrastructure monitoring, periodic access audits, security updates, and workflow iterations as your firm scales.'],
      ],
    };

const partnerLogos = [
  ['Anytime Fitness', '/partners/anytime.webp'],
  ['KelolaAja', '/partners/kelolaaja.webp'],
  ['Nikawa Teknika', '/partners/nikawa.webp'],
  ['PT Inti Bersama', '/partners/ptintibersama.webp'],
];
---

<!-- Hero Section with Background Image and Gradient Overlay -->
<section class="relative isolate min-h-[38rem] overflow-hidden bg-white py-28 sm:min-h-[42rem] sm:py-32 lg:min-h-[46rem] lg:py-40" aria-labelledby="business-title">
  <picture>
    <source srcset="/industry/herobisnis.webp" type="image/webp" />
    <img src="/industry/herobisnis.webp" alt="" width="1536" height="1024" class="absolute inset-0 -z-20 h-full w-full object-cover object-[64%_center]" loading="eager" decoding="async" />
  </picture>
  <div class="absolute inset-0 -z-10 bg-white/84 sm:bg-gradient-to-r sm:from-white sm:from-[7%] sm:via-white/86 sm:via-[46%] sm:to-white/0 sm:to-[80%]"></div>
  <div class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-40 bg-gradient-to-b from-transparent to-white"></div>
  <div class="home-container flex min-h-[calc(38rem-7rem)] items-end sm:min-h-[calc(42rem-8rem)] lg:min-h-[calc(46rem-10rem)]">
    <div class="max-w-3xl pb-2 lg:pb-5">
      <p data-reveal="title" class="text-[11px] font-semibold tracking-[0.14em] text-slate-600">{copy.eyebrow}</p>
      <h1 id="business-title" data-reveal="title" class="stagger-1 mt-4 max-w-3xl text-4xl font-medium leading-[1.06] tracking-[-0.05em] text-slate-950 sm:text-5xl lg:text-[4.5rem]">
        {copy.title}
      </h1>
      <p data-reveal="text" class="stagger-2 mt-6 max-w-xl text-base leading-relaxed text-slate-700 sm:text-lg">{copy.lead}</p>
      <a data-reveal="scale" href="https://wa.me/628517442245" target="_blank" rel="noopener noreferrer" class="stagger-3 mt-8 inline-flex min-h-12 items-center justify-center rounded-full bg-[#f5a623] px-6 text-sm font-semibold text-slate-950 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:bg-[#e69818] hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 focus-visible:ring-offset-2">
        {copy.primaryCta}
      </a>
    </div>
  </div>
</section>

<!-- Challenges Section with Sticky Secondary Photo and Numbered Grid -->
<section class="home-section bg-white" aria-labelledby="business-challenges-title">
  <div class="home-container grid grid-cols-1 gap-10 lg:grid-cols-2 lg:items-stretch lg:gap-12">
    <div data-reveal="scale" class="group relative overflow-hidden rounded-[24px] lg:sticky lg:top-28 lg:self-start">
      <picture>
        <source srcset="/industry/secondarybisnis.webp" type="image/webp" />
        <img src="/industry/secondarybisnis.webp" alt="Modern corporate advisory and professional services operations" width="1448" height="1086" class="h-[21rem] w-full object-cover sm:h-[28rem] lg:h-[38rem]" loading="lazy" decoding="async" />
      </picture>
      <div class="absolute inset-0 bg-slate-950/30 transition-opacity duration-500 ease-out group-hover:opacity-0"></div>
      <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-slate-950/65 to-transparent"></div>
      <div class="absolute inset-x-0 bottom-0 p-6 sm:p-7">
        <span class="font-mono text-[10px] font-semibold tracking-[0.18em] text-white/80">CONNECTED CLIENT OPERATIONS</span>
      </div>
    </div>
    <div class="flex flex-col">
      <h2 id="business-challenges-title" data-reveal="title" class="max-w-xl text-3xl font-medium leading-tight tracking-[-0.04em] text-slate-950 sm:text-4xl lg:text-5xl">{copy.challengesTitle}</h2>
      <p data-reveal="text" class="stagger-1 mt-5 max-w-xl text-sm leading-relaxed text-slate-600 sm:text-base">{copy.challengesLead}</p>
      <ol class="mt-10 grid flex-1 grid-cols-1 gap-x-8 sm:mt-12 sm:grid-cols-2">
        {copy.challenges.map(([title, description], index) => (
          <li data-reveal="scale" class={`group border-t border-slate-200 py-6 sm:py-7 stagger-${index + 1}`}>
            <div class="flex items-baseline justify-between gap-5">
              <span class="font-mono text-xs font-medium tracking-[0.12em] text-slate-400">{String(index + 1).padStart(2, '0')}</span>
              <span class="h-px flex-1 bg-slate-100 transition-colors duration-300 group-hover:bg-violet-200"></span>
            </div>
            <h3 class="mt-7 text-xl font-semibold tracking-[-0.03em] text-slate-950">{title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">{description}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<!-- Solutions Grid Section (6 Cards with Hover Gradient Glow & Custom Icons) -->
<section id="business-solutions" class="home-section bg-white scroll-mt-20" aria-labelledby="business-solutions-title">
  <div class="home-container">
    <div data-reveal="title" class="mx-auto max-w-3xl text-center">
      <h2 id="business-solutions-title" class="text-3xl font-medium leading-tight tracking-[-0.04em] text-slate-950 sm:text-4xl lg:text-5xl">{copy.solutionsTitle}</h2>
      <p class="stagger-1 mx-auto mt-5 max-w-2xl text-sm leading-relaxed text-slate-600 sm:text-base">{copy.solutionsLead}</p>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-4 sm:mt-12 sm:gap-5 md:grid-cols-2 lg:grid-cols-3">
      {copy.solutions.map(([title, description, icon], index) => (
        <article data-reveal="scale" class={`business-solution-card group relative isolate flex min-h-[17rem] overflow-hidden rounded-[20px] border border-slate-200/90 bg-white p-6 sm:min-h-[18rem] sm:p-7 stagger-${index + 1}`}>
          <div class="relative z-10 flex w-full flex-col justify-between">
            <span class="business-solution-icon flex h-10 w-10 items-center justify-center text-slate-950" aria-hidden="true">
              {icon === 'portal' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="4" y="5.5" width="24" height="21" rx="3" stroke-linejoin="round" />
                  <path d="M4 11h24M11 16h10M11 20h6" stroke-linecap="round" />
                  <circle cx="21" cy="20" r="2.5" />
                </svg>
              )}
              {icon === 'billing' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5">
                  <circle cx="16" cy="16" r="11" />
                  <path d="M16 10v6l4 2.5" stroke-linecap="round" stroke-linejoin="round" />
                  <path d="M16 5V3M16 29v-2M5 16H3M29 16h-2" stroke-linecap="round" />
                </svg>
              )}
              {icon === 'scheduling' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="4.5" y="6" width="23" height="20" rx="3" stroke-linejoin="round" />
                  <path d="M5 12h22M10 4v4M22 4v4" stroke-linecap="round" />
                  <rect x="8.5" y="16" width="6" height="3" rx="1" fill="currentColor" fill-opacity="0.2" />
                  <rect x="17.5" y="16" width="6" height="3" rx="1" fill="currentColor" fill-opacity="0.2" />
                </svg>
              )}
              {icon === 'contract' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M8 4.5h11l6 6v17H8z" stroke-linejoin="round" />
                  <path d="M19 4.5v6h6M12 15h8M12 19h5" stroke-linecap="round" />
                  <circle cx="19" cy="23" r="3" />
                  <path d="M21 25.5l2 3" stroke-linecap="round" />
                </svg>
              )}
              {icon === 'knowledge' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M5 7a3 3 0 0 1 3-3h18v21H8a3 3 0 0 0-3 3V7z" stroke-linejoin="round" />
                  <path d="M5 25a3 3 0 0 1 3-3h18M11 9h10M11 13h7" stroke-linecap="round" />
                </svg>
              )}
              {icon === 'integration' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="4" y="6" width="9" height="7" rx="2" />
                  <rect x="19" y="6" width="9" height="7" rx="2" />
                  <rect x="11.5" y="19" width="9" height="7" rx="2" />
                  <path d="M8.5 13v3a3 3 0 0 0 3 3h4.5m7.5-6v3a3 3 0 0 1-3 3h-4.5" stroke-linecap="round" />
                </svg>
              )}
            </span>
            <div class="mt-12">
              <h3 class="max-w-sm text-xl font-medium tracking-[-0.025em] text-slate-950 sm:text-[22px]">{title}</h3>
              <p class="mt-3 max-w-md text-sm leading-relaxed text-slate-600">{description}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- Approach Section (3 Domain Cards with Bespoke Business Services Schematics) -->
<section class="home-section bg-white" aria-labelledby="business-approach-title">
  <div class="home-container">
    <div data-reveal="title" class="mx-auto max-w-4xl text-center">
      <h2 id="business-approach-title" class="text-3xl font-medium leading-tight tracking-[-0.04em] text-slate-950 sm:text-4xl lg:text-5xl">{copy.approachTitle}</h2>
    </div>
    <div class="mt-10 grid grid-cols-1 gap-4 sm:mt-12 lg:grid-cols-3 lg:gap-5">
      {copy.domains.map(([title, description, key], index) => (
        <article data-reveal="scale" class={`business-domain-card business-domain-${key} flex min-h-[18rem] flex-col rounded-[20px] border border-slate-200 bg-white p-6 sm:p-7 stagger-${index + 1}`}>
          <div class="flex items-start justify-between gap-5">
            <span class="font-mono text-xs font-medium tracking-[0.12em] text-slate-400">{String(index + 1).padStart(2, '0')}</span>
            <span class="text-[11px] font-medium tracking-[0.08em] text-slate-400">
              {key === 'tenancy' ? 'GOVERNANCE' : key === 'utilization' ? 'UTILIZATION' : 'ORCHESTRATION'}
            </span>
          </div>
          <div class="business-domain-visual mt-5 text-slate-900" aria-hidden="true">
            {key === 'tenancy' && (
              <svg viewBox="0 0 260 112" fill="none" stroke="currentColor" stroke-width="1.45">
                <path d="M20 56h40m32 0h38m32 0h38" stroke-linecap="round" />
                <circle cx="16" cy="56" r="8" fill="white" />
                <rect x="66" y="34" width="38" height="44" rx="7" fill="white" />
                <rect x="154" y="34" width="38" height="44" rx="7" fill="white" />
                <circle cx="224" cy="56" r="8" fill="white" />
                <path d="M77 48h16M77 56h10M77 64h16m72-16h16m-16 8h10m-10 8h16" stroke-linecap="round" />
              </svg>
            )}
            {key === 'utilization' && (
              <svg viewBox="0 0 320 112" fill="none" stroke="currentColor" stroke-width="1.45">
                <path d="M16 56h50m38 0h50m38 0h50" stroke-linecap="round" />
                <circle cx="16" cy="56" r="8" fill="white" />
                <path d="M66 40h42v32H66z" fill="white" stroke-linejoin="round" />
                <path d="M74 48h26m-26 8h18m-18 8h22" stroke-linecap="round" />
                <circle cx="172" cy="56" r="16" fill="white" />
                <path d="M164 56h16M172 48v16" stroke-linecap="round" />
                <path d="M228 36 268 50v24c0 15-11 26-20 30-9-4-20-15-20-30V50z" fill="white" />
                <path d="m239 71 7 7 14-17" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
            {key === 'workflow' && (
              <svg viewBox="0 0 250 112" fill="none" stroke="currentColor" stroke-width="1.45">
                <path d="M18 86h214" stroke-linecap="round" />
                <path d="M25 76c22 0 19-38 43-38s22 27 42 27 22-43 46-43 17 45 40 45 20-21 32-21" stroke-linecap="round" stroke-linejoin="round" />
                <circle cx="68" cy="38" r="6" fill="white" />
                <circle cx="110" cy="65" r="6" fill="white" />
                <circle cx="156" cy="22" r="6" fill="white" />
                <circle cx="196" cy="67" r="6" fill="white" />
                <path d="M220 20v22m-11-11h22" stroke-linecap="round" />
              </svg>
            )}
          </div>
          <div class="mt-auto pt-6">
            <h3 class="text-xl font-semibold tracking-[-0.03em] text-slate-950">{title}</h3>
            <p class="mt-2.5 max-w-xl text-sm leading-relaxed text-slate-600">{description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- Deep-Dive Editorial Section with Sticky Desktop TOC & Mobile Drawer -->
<BusinessServicesAboutIndustry lang={lang} />

<!-- FAQ Section with Accordion and Partner Trust Bar -->
