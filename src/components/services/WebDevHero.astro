---
// src/components/services/WebDevHero.astro
import { getTranslations, type Locale } from '../../i18n/translations';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = getTranslations(lang);
const data = t.webDevService;

// Partner logos for trust badges (identical to Faq.astro on main page)
const partnerLogos = [
  {
    name: 'Anytime Fitness',
    logo: '/partners/anytime.png',
  },
  {
    name: 'KelolaAja',
    logo: '/partners/kelolaaja.png',
  },
  {
    name: 'Nikawa Teknika',
    logo: '/partners/nikawa.png',
  },
  {
    name: 'PT Inti Bersama',
    logo: '/partners/ptintibersama.png',
  },
];
---

<section
  id="web-dev-hero"
  aria-label={data.hero.headline}
  class="relative isolate overflow-hidden bg-[#fbfbfc] pt-24 sm:pt-32 pb-14 sm:pb-20 lg:pb-24"
>
  <!-- Background ambient gradient glow -->
  <div class="pointer-events-none absolute -top-40 right-0 -z-10 w-[500px] h-[500px] rounded-full bg-blue-100/40 blur-3xl" aria-hidden="true" />
  <div class="pointer-events-none absolute top-1/3 -left-32 -z-10 w-[450px] h-[450px] rounded-full bg-indigo-100/30 blur-3xl" aria-hidden="true" />

  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row items-center justify-start gap-8 lg:gap-0 relative">
      
      <!-- Left Column: Large Frosted Glass Card (overlaps the sphere on desktop) -->
      <div class="w-full lg:w-[58%] xl:w-[56%] z-20 shrink-0 reveal-scale-init" data-reveal="scale">
        <div
          class="relative rounded-[28px] sm:rounded-[36px] backdrop-blur-2xl shadow-[0_20px_60px_-15px_rgba(15,23,42,0.08)] p-6 sm:p-10 lg:p-12 xl:p-14 overflow-hidden"
          style="background: linear-gradient(135deg, rgba(255, 255, 255, 0.82) 0%, rgba(255, 255, 255, 0.65) 50%, rgba(255, 255, 255, 0.32) 100%); backdrop-filter: blur(28px) saturate(180%); -webkit-backdrop-filter: blur(28px) saturate(180%); border: 1px solid rgba(255, 255, 255, 0.75); box-shadow: 0 20px 60px -15px rgba(15, 23, 42, 0.08), inset 0 1px 1px 0 rgba(255, 255, 255, 0.9);"
        >
          <!-- Soft blue glass reflection glow on the right edge -->
          <div class="pointer-events-none absolute -right-16 top-1/4 w-72 h-72 rounded-full bg-blue-400/15 blur-3xl -z-10" aria-hidden="true"></div>
          
          <!-- Breadcrumb Navigation -->
          <nav aria-label="Breadcrumb" class="mb-6 sm:mb-8">
            <ol class="flex items-center flex-wrap gap-2 text-xs sm:text-sm font-medium text-slate-500 font-sans">
              <li>
                <a href={data.breadcrumbs.homeHref} class="hover:text-slate-900 transition-colors">
                  {data.breadcrumbs.home}
                </a>
              </li>
              <li aria-hidden="true" class="text-slate-400">/</li>
              <li>
                <a href={data.breadcrumbs.servicesHref} class="hover:text-slate-900 transition-colors">
                  {data.breadcrumbs.services}
                </a>
              </li>
              <li aria-hidden="true" class="text-slate-400">/</li>
              <li class="text-slate-900 font-semibold truncate" aria-current="page">
                {data.breadcrumbs.current}
              </li>
            </ol>
          </nav>

          <!-- Social Proof Avatar Badge (Same as FAQ page utama) -->
          <div class="flex items-center gap-3.5 mb-6 sm:mb-8">
            <div class="flex -space-x-3 items-center shrink-0">
              {partnerLogos.map((partner) => (
                <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-white border-2 border-slate-100 flex items-center justify-center overflow-hidden shadow-sm">
                  <img
                    src={partner.logo}
                    alt={partner.name}
                    class="w-5 h-5 sm:w-6 sm:h-6 object-contain"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              ))}
            </div>
            <div class="flex flex-col justify-center text-left leading-tight pl-1">
              <span class="text-xs sm:text-[13px] font-bold text-slate-900 tracking-tight">
                {data.trustBadge.label}
              </span>
              <span class="text-[11px] sm:text-xs text-slate-500 font-normal mt-0.5">
                {data.trustBadge.sublabel}
              </span>
            </div>
          </div>

          <!-- Main Hero Headline -->
          <h1 class="text-2xl sm:text-4xl lg:text-[40px] xl:text-[44px] font-bold text-slate-950 tracking-[-0.025em] leading-[1.18] font-sans mb-5 sm:mb-6">
            {data.hero.headline}
          </h1>

          <!-- Detailed Service Description -->
          <p class="text-sm sm:text-base text-slate-600 leading-relaxed font-normal font-sans mb-7 sm:mb-8">
            {data.hero.description}
          </p>

          <!-- Hero Action Buttons (Amber Pill CTA + Underlined Text Link) -->
          <div class="flex flex-wrap items-center gap-5 sm:gap-6 pt-1">
            <a
              href={data.hero.primaryCtaHref || "/contact"}
              class="inline-flex items-center gap-2 px-6 sm:px-7 py-3 sm:py-3.5 rounded-full bg-[#f5a623] hover:bg-[#e69818] text-slate-950 font-semibold text-xs sm:text-sm shadow-sm transition-all duration-200 hover:shadow-md hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400"
            >
              <span>{data.hero.primaryCta}</span>
              <svg
                class="w-4 h-4 text-slate-950 transition-transform duration-200 group-hover:translate-x-0.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
              </svg>
            </a>
            <a
              href={data.hero.secondaryCtaHref || "#what-we-deliver"}
              class="text-xs sm:text-sm font-semibold text-slate-900 hover:text-blue-600 transition-colors underline underline-offset-4 decoration-slate-300 hover:decoration-blue-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400 rounded"
            >
              {data.hero.secondaryCta}
            </a>
          </div>

        </div>
      </div>

      <!-- Center: 3D Visual Sphere (tucked under the right edge of the card, transparent webp) -->
      <div class="relative w-[300px] sm:w-[360px] lg:w-[420px] xl:w-[460px] aspect-square shrink-0 lg:-ml-32 xl:-ml-40 z-10 select-none pointer-events-none reveal-scale-init stagger-2" data-reveal="scale">
        <img
          src="/services/web_dev_hero_sphere.webp"
          alt="Web Development 3D Architectural Sphere"
          width="1024"
          height="1024"
          class="w-full h-full object-contain scale-105 reveal-img-breathe drop-shadow-xl"
          loading="eager"
          decoding="async"
        />
      </div>

      <!-- Right Column: Quick Jump Table of Contents (Agak kecil, agak atas, di ujung kanan) -->
      <div class="w-full lg:w-auto lg:absolute lg:top-1 xl:top-2 lg:right-0 xl:right-2 z-30 pt-4 lg:pt-0">
        <nav aria-label={data.quickLinks.title} class="flex flex-col items-start lg:items-end gap-1.5 sm:gap-2">
          {data.quickLinks.links.map((link) => (
            <a
              href={link.href}
              class="group inline-flex items-center justify-between lg:justify-end gap-1.5 text-[11.5px] xl:text-[12px] font-normal text-slate-400 hover:text-slate-900 transition-colors py-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400 rounded min-h-[30px] sm:min-h-0"
            >
              <span class="tracking-tight">{link.label}</span>
              <svg
                class="w-3 h-3 text-slate-400 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-slate-900"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17" />
              </svg>
            </a>
          ))}
        </nav>
      </div>

    </div>
  </div>
</section>
