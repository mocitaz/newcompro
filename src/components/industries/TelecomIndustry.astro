---
// src/components/industries/TelecomIndustry.astro
import type { Locale } from '../../i18n/translations';
import TelecomAboutIndustry from './TelecomAboutIndustry.astro';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const isId = lang === 'id';

const copy = isId
  ? {
      eyebrow: 'TELEKOMUNIKASI & REKAYASA JARINGAN',
      title: 'Engineering untuk jaringan telekomunikasi dan operasi carrier-grade modern.',
      lead: 'Bangun dan modernisasi platform telekomunikasi dengan integrasi OSS/BSS terpadu, sistem billing dan kuota real-time, monitoring telemetri jaringan, serta portal pelanggan mandiri. Teknalogi menghadirkan rekayasa perangkat lunak skala operator yang andal dan terukur.',
      primaryCta: 'Diskusikan kebutuhan jaringan Anda',
      challengesTitle: 'Ketika sistem jaringan dan bisnis terpisah, layanan terhambat.',
      challengesLead: 'Operasional melambat ketika telemetri, billing kuota, dan layanan pelanggan berjalan sendiri-sendiri.',
      challenges: [
        ['Sistem OSS/BSS terpisah', 'Silo antar-sistem memperlambat peluncuran paket data dan aktivasi layanan.'],
        ['Latensi rating dan kuota', 'Keterlambatan pemotongan kuota memicu kebocoran pendapatan operator.'],
        ['Deteksi gangguan lambat', 'Banjir alarm tanpa korelasi otomatis menyulitkan tim NOC menemukan akar masalah.'],
        ['Rekonsiliasi wholesale rumit', 'Pencocokan trafik interkoneksi dan log CDR membutuhkan waktu berhari-hari.'],
      ],
      solutionsTitle: 'Solusi perangkat lunak terintegrasi untuk operator telekomunikasi dan ISP.',
      solutionsLead: 'Ruang lingkup sistem disesuaikan dengan topologi jaringan Anda, mulai dari integrasi TM Forum Open API, arsitektur OCS berlatensi rendah, hingga portal mandiri pelanggan.',
      solutions: [
        ['Modernisasi OSS/BSS & TM Forum API', 'Standardisasi integrasi katalog produk, order-to-activate, dan provisi perangkat jaringan otomatis (zero-touch).', 'oss'],
        ['Online Charging (OCS) & Rating Real-Time', 'Mesin kalkulasi kuota dan rating saldo sub-milidetik dengan penegakan kebijakan FUP dinamis tanpa reboot sesi.', 'ocs'],
        ['Telemetri Jaringan & Deteksi Anomali', 'Pipeline streaming SNMP, Syslog, dan gNMI berkecepatan tinggi dengan korelasi alarm otomatis untuk tim NOC.', 'telemetry'],
        ['Portal Pelanggan Mandiri & Aktivasi eSIM', 'Aplikasi mobile pelanggan untuk pembelian paket 1-klik, pemantauan kuota real-time, dan provisi profil eSIM.', 'portal'],
        ['Wholesale, Interkoneksi & Mediasi CDR', 'Normalisasi miliaran file CDR multi-vendor dan otomatisasi kalkulasi bagi hasil trafik terminasi antar-operator.', 'wholesale'],
        ['Keamanan Siber & Proteksi Signaling', 'Firewall signaling (SS7 / Diameter), enkripsi jalur O&M, dan perlindungan data registrasi pelanggan sesuai UU PDP.', 'security'],
      ],
      approachTitle: 'Dirancang untuk keandalan carrier-grade dan rating kuota berkecepatan tinggi.',
      domains: [
        ['Rating Kuota Real-Time & Skalabilitas OCS', 'Terapkan arsitektur in-memory cache terdistribusi yang mengevaluasi saldo kuota sub-milidetik untuk jutaan sesi aktif.', 'concurrency'],
        ['Telemetri Jaringan Streaming & Isolasi Anomali', 'Bangun pipeline ingestion telemetri masif untuk mengkorelasikan ribuan alarm menjadi satu notifikasi insiden utama.', 'telemetry_domain'],
        ['Keandalan Carrier-Grade 99.999% & Geo-Redundansi', 'Rancang arsitektur active-active multi-datacenter dengan failover otomatis tanpa kehilangan data transaksi sesi.', 'availability'],
      ],
      faqTitle: 'Hal yang biasanya dibahas sebelum proyek telekomunikasi dimulai.',
      faqLead: 'Karakteristik elemen jaringan (NE), vendor switch/router, dan format data CDR setiap operator sangat bervariasi. Discovery teknis kami memetakan antarmuka sistem, throughput data, dan target ketersediaan.',
      faqTrustTitle: 'Dipercaya oleh',
      faqTrustText: 'Penyedia jaringan dan operator telekomunikasi di Indonesia',
      faqAction: 'Tanyakan kebutuhan jaringan Anda',
      faqs: [
        ['Apakah arsitektur Teknalogi mengadopsi standar TM Forum Open API?', 'Ya. Kami menerapkan spesifikasi TM Forum Open API (seperti TMF620 untuk Product Catalog, TMF622 untuk Product Ordering, dan TMF641 untuk Service Ordering) guna memastikan sistem modular dan mudah diintegrasikan dengan vendor pihak ketiga.'],
        ['Bagaimana sistem OCS menangani jutaan transaksi rating kuota bersamaan?', 'Kami membangun mesin OCS dengan arsitektur in-memory caching terdistribusi dan pemrosesan asinkron non-blocking, mampu memproses evaluasi saldo dan reservasi kuota dengan latensi di bawah 5 milidetik per request.'],
        ['Bisakah sistem mediasi CDR mengolah file dari berbagai vendor perangkat jaringan (multi-vendor)?', 'Bisa. Engine mediasi kami dilengkapi parser fleksibel untuk mengolah format biner (ASN.1), CSV, dan proprietary dump dari perangkat Huawei, Ericsson, Cisco, ZTE, dan Nokia menjadi format data standar tunggal.'],
        ['Bagaimana integrasi provisi profil eSIM pada aplikasi pelanggan?', 'Kami mengintegrasikan aplikasi mobile dengan server SM-DP+ (Subscription Manager Data Preparation) resmi melalui protokol GSMA RSP (Remote SIM Provisioning), memungkinkan pengunduhan profil eSIM langsung ke smartphone dalam hitungan detik.'],
        ['Apakah sistem telemetri jaringan dapat dihubungkan dengan perangkat lama (legacy SNMP)?', 'Bisa. Pipeline telemetri kami mendukung dual-mode ingestion, baik polling SNMP v2c/v3 dan Syslog tradisional maupun streaming telemetry modern berbasis gRPC / gNMI.'],
        ['Bagaimana sistem menjamin ketersediaan layanan 99.999% (five-nines)?', 'Kami menerapkan arsitektur terdistribusi geo-redundant active-active dengan replikasi database sinkron dan health-check otomatis yang memicu pengalihan beban (failover) dalam milidetik tanpa interupsi sesi pengguna.'],
        ['Apakah tersedia modul penagihan interkoneksi dan pemantauan SLA wholesale?', 'Ya. Modul wholesale kami menyediakan perhitungan tarif interkoneksi otomatis, pemantauan utilisasi bandwidth sirkuit sewa (Metro-E/IPLC), dan dashboard pelaporan SLA per mitra operator.'],
        ['Apakah Teknalogi menyediakan dukungan teknis 24/7 untuk sistem kritis operator?', 'Ya. Kami menyediakan paket SLA khusus carrier-grade dengan dedicated engineer standby 24/7, pemantauan proaktif, dan respon cepat untuk insiden tingkat P1/P2.'],
      ],
    }
  : {
      eyebrow: 'TELECOMMUNICATIONS & NETWORK ENGINEERING',
      title: 'Engineering for high-bandwidth networks and carrier-grade operations.',
      lead: 'Build resilient telecom platforms with automated OSS/BSS integration, real-time subscriber charging, network telemetry monitoring, and customer self-service portals. Teknalogi empowers telecom operators and ISPs with carrier-grade digital systems.',
      primaryCta: 'Discuss your telecom requirements',
      challengesTitle: 'When network and business systems disconnect, service degrades.',
      challengesLead: 'Operations slow down when telemetry, billing, and customer service operate in silos.',
      challenges: [
        ['Disconnected OSS/BSS', 'Isolated operations and commercial systems slow down new data plan rollouts.'],
        ['Billing and rating latency', 'Delayed quota deduction triggers balance discrepancies and revenue leakage.'],
        ['Slow fault detection', 'Uncorrelated alarm storms delay NOC teams from isolating root causes.'],
        ['Complex partner settlement', 'Reconciling wholesale interconnect traffic and CDR logs takes days of manual effort.'],
      ],
      solutionsTitle: 'Integrated software solutions engineered for telecom operators and ISPs.',
      solutionsLead: 'System architectures are custom-tailored to your network topology, spanning TM Forum Open API integration, low-latency OCS rating, and subscriber digital self-service.',
      solutions: [
        ['OSS/BSS Modernization & TM Forum APIs', 'Standardized product catalog integration, order-to-activate pipelines, and zero-touch network device provisioning.', 'oss'],
        ['Online Charging (OCS) & Real-Time Rating', 'Sub-millisecond rating engines with dynamic Fair Usage Policy (FUP) bandwidth throttling without session resets.', 'ocs'],
        ['Network Telemetry & Fault Diagnostics', 'High-throughput SNMP, Syslog, and gNMI streaming ingestion with automated root-cause alarm correlation for NOCs.', 'telemetry'],
        ['Subscriber Self-Service & Instant eSIM', 'Native customer apps for 1-click plan top-ups, live quota tracking, and instant digital eSIM profile delivery.', 'portal'],
        ['Wholesale, Interconnect & CDR Mediation', 'Batch normalization of multi-vendor CDR files with automated inter-carrier termination settlement calculations.', 'wholesale'],
        ['Signaling Defense & Carrier Cybersecurity', 'SS7 and Diameter signaling firewalls, hardened O&M channel encryption, and subscriber data privacy governance.', 'security'],
      ],
      approachTitle: 'Designed for carrier-grade availability and high-throughput telecom rating.',
      domains: [
        ['Sub-Millisecond Event Rating & OCS Concurrency', 'Deploy distributed in-memory cache tiers evaluating subscriber quota balances with sub-millisecond latency under massive load.', 'concurrency'],
        ['Real-Time Telemetry & Fault Isolation', 'Ingest carrier-scale telemetry streams to correlate thousands of downstream alarms into actionable root-cause incident tickets.', 'telemetry_domain'],
        ['Carrier-Grade 99.999% Availability & Geo-Redundancy', 'Architect active-active multi-datacenter deployments ensuring zero data loss and automated failover for continuous sessions.', 'availability'],
      ],
      faqTitle: 'What teams usually discuss before a telecom project starts.',
      faqLead: 'Network element interfaces, switch vendor formats, and subscriber concurrency targets vary across operators. Technical discovery maps integration protocols, data rates, and availability objectives.',
      faqTrustTitle: 'Trusted by',
      faqTrustText: 'Network providers and growing telecom operators across Indonesia',
      faqAction: 'Ask about your network requirements',
      faqs: [
        ['Does Teknalogi’s architecture follow TM Forum Open API standards?', 'Yes. We implement TM Forum Open API standards (including TMF620 for Product Catalog, TMF622 for Product Ordering, and TMF641 for Service Ordering) to ensure decoupled, vendor-agnostic interoperability across your OSS/BSS ecosystem.'],
        ['How does the OCS platform handle millions of concurrent quota evaluation requests?', 'We engineer OCS rating engines using distributed in-memory cache clusters and non-blocking asynchronous event loops, delivering balance deduction and quota reservations with sub-5ms latencies.'],
        ['Can the CDR mediation engine process heterogeneous multi-vendor network dumps?', 'Yes. Our mediation pipeline features extensible parsers converting binary ASN.1, CSV, and proprietary switch dumps from Huawei, Ericsson, Cisco, ZTE, and Nokia into unified data models.'],
        ['How is digital eSIM provisioning integrated into customer apps?', 'We interface subscriber mobile apps with certified SM-DP+ (Subscription Manager Data Preparation) servers via GSMA Remote SIM Provisioning protocols, enabling instant QR activation within seconds.'],
        ['Can the telemetry platform interface with legacy SNMP hardware?', 'Yes. Our ingestion pipeline supports dual-mode operation, ingesting traditional SNMP v2c/v3 traps and Syslog streams alongside modern gRPC / gNMI streaming telemetry without performance penalties.'],
        ['How does the system guarantee 99.999% (five-nines) carrier availability?', 'We deploy geo-redundant active-active multi-region clusters with synchronous state replication and automated health checks that execute traffic rerouting in milliseconds during link failures.'],
        ['Does the platform support wholesale interconnect billing and SLA tracking?', 'Yes. The wholesale module provides automated voice/SMS termination rate calculation, dedicated IPLC/Metro-E link utilization tracking, and automated partner SLA compliance reporting.'],
        ['Does Teknalogi provide 24/7 carrier support SLAs?', 'Yes. We provide dedicated 24/7 carrier-grade SLA packages with standby engineering coverage, proactive infrastructure telemetry monitoring, and rapid emergency escalation for P1/P2 incidents.'],
      ],
    };

const partnerLogos = [
  ['Anytime Fitness', '/partners/anytime.png'],
  ['KelolaAja', '/partners/kelolaaja.png'],
  ['Nikawa Teknika', '/partners/nikawa.png'],
  ['PT Inti Bersama', '/partners/ptintibersama.png'],
];
---

<section class="relative isolate min-h-[38rem] overflow-hidden bg-white py-28 sm:min-h-[42rem] sm:py-32 lg:min-h-[46rem] lg:py-40" aria-labelledby="telecom-title">
  <img src="/industry/herotelecom.png" alt="Telecommunications infrastructure and network operations center" width="1536" height="1024" class="absolute inset-0 -z-20 h-full w-full object-cover object-[64%_center]" loading="eager" decoding="async" />
  <div class="absolute inset-0 -z-10 bg-white/84 sm:bg-gradient-to-r sm:from-white sm:from-[7%] sm:via-white/86 sm:via-[46%] sm:to-white/0 sm:to-[80%]"></div>
  <div class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-40 bg-gradient-to-b from-transparent to-white"></div>
  <div class="home-container flex min-h-[calc(38rem-7rem)] items-end sm:min-h-[calc(42rem-8rem)] lg:min-h-[calc(46rem-10rem)]">
    <div class="max-w-3xl pb-2 lg:pb-5">
      <p class="text-[11px] font-semibold tracking-[0.14em] text-slate-600">{copy.eyebrow}</p>
      <h1 id="telecom-title" class="mt-4 max-w-3xl text-4xl font-medium leading-[1.06] tracking-[-0.05em] text-slate-950 sm:text-5xl lg:text-[4.5rem]">
        {copy.title}
      </h1>
      <p class="mt-6 max-w-xl text-base leading-relaxed text-slate-700 sm:text-lg">{copy.lead}</p>
      <a href="https://wa.me/628517442245" target="_blank" rel="noopener noreferrer" class="mt-8 inline-flex min-h-12 items-center justify-center rounded-full bg-[#f5a623] px-6 text-sm font-semibold text-slate-950 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:bg-[#e69818] hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber-400 focus-visible:ring-offset-2">
        {copy.primaryCta}
      </a>
    </div>
  </div>
</section>

<section class="home-section bg-white" aria-labelledby="telecom-challenges-title">
  <div class="home-container grid grid-cols-1 gap-10 lg:grid-cols-2 lg:items-stretch lg:gap-12">
    <div class="group relative overflow-hidden rounded-[24px] lg:sticky lg:top-28 lg:self-start">
      <img src="/industry/secondarytelecom.png" alt="Optical fiber transceivers and high-speed network routing hardware" width="1448" height="1086" class="h-[21rem] w-full object-cover sm:h-[28rem] lg:h-[38rem]" loading="lazy" decoding="async" />
      <div class="absolute inset-0 bg-slate-950/30 transition-opacity duration-500 ease-out group-hover:opacity-0"></div>
      <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-slate-950/65 to-transparent"></div>
      <div class="absolute inset-x-0 bottom-0 p-6 sm:p-7">
        <span class="font-mono text-[10px] font-semibold tracking-[0.18em] text-white/80">CONNECTED TELECOM</span>
      </div>
    </div>
    <div class="flex flex-col">
      <h2 id="telecom-challenges-title" class="max-w-xl text-3xl font-medium leading-tight tracking-[-0.04em] text-slate-950 sm:text-4xl lg:text-5xl">{copy.challengesTitle}</h2>
      <p class="mt-5 max-w-xl text-sm leading-relaxed text-slate-600 sm:text-base">{copy.challengesLead}</p>
      <ol class="mt-10 grid flex-1 grid-cols-1 gap-x-8 sm:mt-12 sm:grid-cols-2">
        {copy.challenges.map(([title, description], index) => (
          <li class="group border-t border-slate-200 py-6 sm:py-7">
            <div class="flex items-baseline justify-between gap-5">
              <span class="font-mono text-xs font-medium tracking-[0.12em] text-slate-400">{String(index + 1).padStart(2, '0')}</span>
              <span class="h-px flex-1 bg-slate-100 transition-colors duration-300 group-hover:bg-violet-200"></span>
            </div>
            <h3 class="mt-7 text-xl font-semibold tracking-[-0.03em] text-slate-950">{title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">{description}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<section id="telecom-solutions" class="home-section bg-white scroll-mt-20" aria-labelledby="telecom-solutions-title">
  <div class="home-container">
    <div class="mx-auto max-w-3xl text-center">
      <h2 id="telecom-solutions-title" class="text-3xl font-medium leading-tight tracking-[-0.04em] text-slate-950 sm:text-4xl lg:text-5xl">{copy.solutionsTitle}</h2>
      <p class="mx-auto mt-5 max-w-2xl text-sm leading-relaxed text-slate-600 sm:text-base">{copy.solutionsLead}</p>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-4 sm:mt-12 sm:gap-5 md:grid-cols-2 lg:grid-cols-3">
      {copy.solutions.map(([title, description, icon]) => (
        <article class="telecom-solution-card group relative isolate flex min-h-[17rem] overflow-hidden rounded-[20px] border border-slate-200/90 bg-white p-6 sm:min-h-[18rem] sm:p-7">
          <div class="relative z-10 flex w-full flex-col justify-between">
            <span class="telecom-solution-icon flex h-10 w-10 items-center justify-center text-slate-950" aria-hidden="true">
              {icon === 'oss' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="4" y="5" width="24" height="9" rx="2" />
                  <rect x="4" y="18" width="24" height="9" rx="2" />
                  <circle cx="8" cy="9.5" r="1" fill="currentColor" />
                  <circle cx="12" cy="9.5" r="1" fill="currentColor" />
                  <circle cx="8" cy="22.5" r="1" fill="currentColor" />
                  <circle cx="12" cy="22.5" r="1" fill="currentColor" />
                  <path d="M16 14v4M22 14v4" stroke-linecap="round" stroke-dasharray="2 2" />
                </svg>
              )}
              {icon === 'ocs' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5">
                  <circle cx="16" cy="16" r="11" />
                  <path d="M16 9v7l5 3" stroke-linecap="round" stroke-linejoin="round" />
                  <path d="M9 16h2M21 16h2" stroke-linecap="round" />
                  <circle cx="16" cy="16" r="2" fill="currentColor" />
                </svg>
              )}
              {icon === 'telemetry' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M4 22h5l3-10 6 16 4-8h6" stroke-linecap="round" stroke-linejoin="round" />
                  <circle cx="16" cy="16" r="12" stroke-dasharray="2 3" />
                </svg>
              )}
              {icon === 'portal' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="7" y="4" width="18" height="24" rx="3" />
                  <line x1="13" y1="7" x2="19" y2="7" stroke-linecap="round" />
                  <circle cx="16" cy="23" r="1.5" fill="currentColor" />
                  <path d="M11 12h10M11 16h7" stroke-linecap="round" />
                </svg>
              )}
              {icon === 'wholesale' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5">
                  <circle cx="9" cy="9" r="4" />
                  <circle cx="23" cy="9" r="4" />
                  <circle cx="16" cy="23" r="4" />
                  <path d="M12 11l2.5 8.5M20 11l-2.5 8.5M13 9h6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
              {icon === 'security' && (
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M16 4l10 4.5v8c0 7-5 11.5-10 13-5-1.5-10-6-10-13v-8L16 4z" stroke-linejoin="round" />
                  <circle cx="16" cy="15" r="2.5" fill="currentColor" />
                  <path d="M16 17.5v4" stroke-linecap="round" />
                </svg>
              )}
            </span>
            <div class="mt-12">
              <h3 class="max-w-sm text-xl font-medium tracking-[-0.025em] text-slate-950 sm:text-[22px]">{title}</h3>
              <p class="mt-3 max-w-md text-sm leading-relaxed text-slate-600">{description}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="home-section bg-white" aria-labelledby="telecom-approach-title">
  <div class="home-container">
    <div class="mx-auto max-w-4xl text-center">
      <h2 id="telecom-approach-title" class="text-3xl font-medium leading-tight tracking-[-0.04em] text-slate-950 sm:text-4xl lg:text-5xl">{copy.approachTitle}</h2>
    </div>
    <div class="mt-10 grid grid-cols-1 gap-4 sm:mt-12 lg:grid-cols-3 lg:gap-5">
      {copy.domains.map(([title, description, key], index) => (
        <article class={`telecom-domain-card telecom-domain-${key} flex min-h-[18rem] flex-col rounded-[20px] border border-slate-200 bg-white p-6 sm:p-7`}>
          <div class="flex items-start justify-between gap-5">
            <span class="font-mono text-xs font-medium tracking-[0.12em] text-slate-400">{String(index + 1).padStart(2, '0')}</span>
            <span class="text-[11px] font-medium tracking-[0.08em] text-slate-400">{key === 'concurrency' ? 'RATING' : key === 'telemetry_domain' ? 'TELEMETRY' : 'AVAILABILITY'}</span>
          </div>
          <div class="telecom-domain-visual mt-5 text-slate-900" aria-hidden="true">
            {key === 'concurrency' && (
              <svg viewBox="0 0 260 112" fill="none" stroke="currentColor" stroke-width="1.45">
                <!-- Subscriber event stream -->
                <rect x="12" y="32" width="38" height="48" rx="6" fill="white" />
                <path d="M20 44h22M20 54h14M20 64h18" stroke-linecap="round" />
                <path d="M50 56h24" stroke-linecap="round" />
                <circle cx="62" cy="56" r="3.5" fill="white" />
                <!-- In-Memory OCS Rating Engine -->
                <rect x="74" y="22" width="72" height="68" rx="8" fill="white" />
                <circle cx="110" cy="56" r="18" fill="white" stroke-dasharray="3 2" />
                <circle cx="110" cy="56" r="6" fill="white" />
                <path d="M110 38v4m0 28v4M92 56h4m28 0h4" stroke-linecap="round" />
                <!-- PCRF policy callback & quota authorization -->
                <path d="M146 56h24" stroke-linecap="round" />
                <circle cx="158" cy="56" r="3.5" fill="white" />
                <rect x="170" y="32" width="56" height="48" rx="6" fill="white" />
                <rect x="180" y="42" width="36" height="20" rx="3" fill="white" />
                <circle cx="190" cy="52" r="2.5" fill="currentColor" />
                <line x1="196" y1="52" x2="208" y2="52" stroke-linecap="round" />
                <circle cx="244" cy="56" r="6" fill="white" />
                <path d="m241 56 2 2 4-4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
            {key === 'telemetry_domain' && (
              <svg viewBox="0 0 320 112" fill="none" stroke="currentColor" stroke-width="1.45">
                <!-- Optical Transport / BTS Router Nodes -->
                <rect x="14" y="28" width="58" height="56" rx="8" fill="white" />
                <circle cx="43" cy="56" r="14" fill="white" stroke-dasharray="3 2" />
                <circle cx="43" cy="56" r="4" fill="white" />
                <path d="M29 56h28M43 42v28" stroke-linecap="round" />
                <!-- Telemetry Ingestion Bus -->
                <path d="M72 56h34" stroke-linecap="round" />
                <circle cx="89" cy="56" r="4" fill="white" />
                <!-- Correlation Engine -->
                <rect x="106" y="18" width="108" height="76" rx="10" fill="white" stroke-dasharray="4 3" />
                <rect x="122" y="30" width="76" height="52" rx="6" fill="white" />
                <path d="M130 56h12l5-14 8 28 8-18 5 4h14" stroke-linecap="round" stroke-linejoin="round" />
                <circle cx="160" cy="24" r="3" fill="white" />
                <circle cx="160" cy="88" r="3" fill="white" />
                <!-- Filtered NOC Incident Ticket -->
                <path d="M214 56h34" stroke-linecap="round" />
                <circle cx="231" cy="56" r="4" fill="white" />
                <rect x="248" y="28" width="58" height="56" rx="8" fill="white" />
                <path d="M260 40h34M260 52h24M260 64h30" stroke-linecap="round" />
                <circle cx="296" cy="64" r="3" fill="white" />
              </svg>
            )}
            {key === 'availability' && (
              <svg viewBox="0 0 250 112" fill="none" stroke="currentColor" stroke-width="1.45">
                <!-- Dual Core Active-Active Rails -->
                <path d="M16 38h48m0 0l24-16h40m-64 16l24 16h40" stroke-linecap="round" stroke-linejoin="round" />
                <circle cx="16" cy="38" r="6" fill="white" />
                <!-- Redundant Core Routing Clusters -->
