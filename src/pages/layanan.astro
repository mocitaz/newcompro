---
// src/pages/layanan.astro - Services Hub (EN)
import Layout from "../layouts/Layout.astro";
import TopBar from "../components/TopBar.astro";
import IndustryComingSoon from "../components/IndustryComingSoon.astro";
import LetsTalk from "../components/LetsTalk.astro";
import BackToTop from "../components/BackToTop.astro";
---

<Layout
  lang="en"
  title="Enterprise Services | PT Teknalogi Transformasi Digital"
  description="Enterprise software engineering, system architecture, and technology solutions by Teknalogi."
>
  <TopBar lang="en" />
  <main class="min-h-screen bg-white">
    <IndustryComingSoon
      lang="en"
      title="Coming Soon"
      subtitle="Our comprehensive enterprise services catalog and engineering solutions portfolio are currently in preparation."
    />
    <LetsTalk lang="en" bgWhite={true} />
  </main>
  <BackToTop label="Back to top" />
</Layout>
