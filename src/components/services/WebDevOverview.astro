---
// src/components/services/WebDevOverview.astro
import { getTranslations, type Locale } from '../../i18n/translations';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = getTranslations(lang);
const { overview, solutions } = t.webDevService;
---

<!-- Section 1: About This Service (#about-service) -->
<section
  id="about-service"
  aria-label={overview.headline}
  class="relative isolate bg-[#fbfbfc] py-16 sm:py-24 lg:py-28 border-t border-slate-200/80"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
      
      <!-- Left Column: Editorial Summary -->
      <div class="lg:col-span-5 reveal-init" data-reveal="title">
        <span class="inline-block text-[11px] sm:text-xs font-semibold uppercase tracking-wider text-indigo-600 bg-indigo-50 border border-indigo-200/60 px-3.5 py-1 rounded-full mb-3.5 font-mono">
          {overview.badge}
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-slate-950 tracking-tight font-sans leading-tight">
          {overview.headline}
        </h2>
        <p class="mt-4 text-sm sm:text-base text-slate-600 leading-relaxed font-normal font-sans">
          {overview.description}
        </p>
      </div>

      <!-- Right Column: 3 Architectural Pillars -->
      <div class="lg:col-span-7 flex flex-col gap-5 sm:gap-6">
        {overview.pillars.map((pillar, index) => (
          <div
            data-reveal="scale"
            class={`rounded-2xl border border-slate-200/80 bg-white p-6 sm:p-7 shadow-xs hover:border-slate-300 transition-colors reveal-scale-init stagger-${index + 1}`}
          >
            <div class="flex items-start gap-4">
              <span class="w-8 h-8 rounded-xl bg-slate-100 text-slate-900 flex items-center justify-center font-bold text-xs shrink-0 mt-0.5 font-mono">
                0{index + 1}
              </span>
              <div>
                <h3 class="text-base sm:text-lg font-bold text-slate-950 tracking-tight font-sans mb-1.5">
                  {pillar.title}
                </h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal font-sans">
                  {pillar.desc}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>

<!-- Section 2: Explore Solutions & Deliverables (#solutions) -->
<section
  id="solutions"
  aria-label={solutions.headline}
  class="relative isolate bg-white py-16 sm:py-24 lg:py-32 border-t border-slate-200/80"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header Centered -->
    <div class="max-w-3xl mx-auto text-center mb-12 sm:mb-16 lg:mb-20 reveal-init" data-reveal="title">
      <span class="inline-block text-[11px] sm:text-xs font-semibold uppercase tracking-wider text-indigo-600 bg-indigo-50 border border-indigo-200/60 px-3.5 py-1 rounded-full mb-3.5 font-mono">
        {solutions.badge}
      </span>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-slate-950 tracking-tight font-sans leading-tight">
        {solutions.headline}
      </h2>
      <p class="mt-4 text-sm sm:text-base text-slate-600 leading-relaxed font-normal font-sans max-w-2xl mx-auto">
        {solutions.subheadline}
      </p>
    </div>

    <!-- 5 Horizontal / Grid Steps -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {solutions.steps.map((step, idx) => (
        <div
          data-reveal="scale"
          class={`rounded-2xl border border-slate-200/80 bg-white p-6 sm:p-8 shadow-xs hover:shadow-md transition-all flex flex-col justify-between reveal-scale-init stagger-${(idx % 3) + 1}`}
        >
          <div>
            <span class="inline-block text-xs font-bold text-indigo-600 font-mono tracking-wider mb-4">
              STEP {step.number}
            </span>
            <h3 class="text-base sm:text-lg font-bold text-slate-950 tracking-tight font-sans mb-2.5">
              {step.title}
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal font-sans">
              {step.desc}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
