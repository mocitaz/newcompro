---
import { getTranslations, type Locale } from '../i18n/translations';

interface Props {
  lang?: Locale;
}

const { lang = 'id' } = Astro.props;
const t = getTranslations(lang);
const industries = t.industries.items;
const layananUrl = lang === 'id' ? '/id/layanan' : '/layanan';

const topRowItems = industries.slice(0, 2);
const bottomRowItems = industries.slice(2, 5);
---

<section
  id="industries"
  aria-label={lang === 'en' ? 'Industries We Serve' : 'Sektor dan Industri yang Kami Layani'}
  class="home-section home-container scroll-mt-24"
>
  <div class="mb-10 grid grid-cols-1 items-start gap-5 lg:mb-14 lg:grid-cols-12 lg:gap-14">
    <div class="lg:col-span-5">
      <h2 class="text-2xl font-bold leading-tight tracking-[-0.02em] text-slate-950 sm:text-3xl lg:text-[2.15rem]">
        {t.industries.headline}
      </h2>
    </div>
    <p class="text-sm leading-relaxed text-slate-600 sm:text-base lg:col-span-7">
      {t.industries.description}
    </p>
  </div>

  <div class="space-y-9 sm:space-y-12">
    <div class="grid grid-cols-1 gap-x-5 gap-y-8 md:grid-cols-2 sm:gap-x-6">
      {topRowItems.map((item) => (
        <a href={layananUrl} class="group block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400 focus-visible:ring-offset-4">
          <figure class="aspect-[4/3] overflow-hidden rounded-[18px] bg-slate-100">
            <picture class="block h-full w-full">
              <source srcset={item.image} type="image/webp" />
              <img
                src={item.fallback}
                alt={item.title}
                class="industry-card-img h-full w-full object-cover"
                loading="lazy"
                decoding="async"
                width="1200"
                height="900"
              />
            </picture>
          </figure>
          <span class="mt-4 flex items-center justify-between gap-4 border-b border-slate-200 pb-3 text-slate-950">
            <span class="text-base font-medium tracking-[-0.02em] sm:text-lg">{item.title}</span>
            <svg class="h-4 w-4 shrink-0 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 12h14m-6-6 6 6-6 6" />
            </svg>
          </span>
        </a>
      ))}
    </div>

    <div class="grid grid-cols-1 gap-x-5 gap-y-8 md:grid-cols-3 sm:gap-x-6">
      {bottomRowItems.map((item) => (
        <a href={layananUrl} class="group block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400 focus-visible:ring-offset-4">
          <figure class="aspect-[4/3] overflow-hidden rounded-[18px] bg-slate-100">
            <picture class="block h-full w-full">
              <source srcset={item.image} type="image/webp" />
              <img
                src={item.fallback}
                alt={item.title}
                class="industry-card-img h-full w-full object-cover"
                loading="lazy"
                decoding="async"
                width="900"
                height="675"
              />
            </picture>
          </figure>
          <span class="mt-4 flex items-center justify-between gap-4 border-b border-slate-200 pb-3 text-slate-950">
            <span class="text-base font-medium tracking-[-0.02em]">{item.title}</span>
            <svg class="h-4 w-4 shrink-0 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 12h14m-6-6 6 6-6 6" />
            </svg>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .industry-card-img {
    filter: grayscale(100%) brightness(1.12) contrast(0.82);
    transform: scale(1);
    transition: transform 520ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .group:hover .industry-card-img {
    transform: scale(1.02);
  }

  @media (prefers-reduced-motion: reduce) {
    .industry-card-img,
    .group:hover .industry-card-img {
      transform: none;
      transition: none;
    }
  }
</style>
