---
// src/components/services/WorkflowAutoFeatures.astro
import { getTranslations, type Locale } from '../../i18n/translations';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = getTranslations(lang);
const features = t.workflowAutoService.features;
---

<section
  id="what-we-deliver"
  aria-label={features.headline}
  class="relative isolate bg-white py-12 sm:py-20 lg:py-28"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header Centered -->
    <div class="max-w-3xl mx-auto text-center mb-8 sm:mb-14 lg:mb-20 reveal-init" data-reveal="title">
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-slate-950 tracking-tight font-sans leading-tight">
        {features.headline}
      </h2>
      <p class="mt-3 sm:mt-4 text-sm sm:text-base text-slate-600 leading-relaxed font-normal font-sans max-w-2xl mx-auto">
        {features.subheadline}
      </p>
    </div>

    <!-- 3-Column Compact Editorial Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 items-stretch">
      {features.items.map((item, index) => {
        const rowIndex = Math.floor(index / 3);
        return (
          <div
            data-reveal="scale"
            class={`feature-card feature-row-${rowIndex} feature-card-${index} group relative flex min-h-0 sm:min-h-[17.5rem] flex-col justify-between overflow-hidden rounded-[20px] border border-slate-200/85 bg-white p-5 sm:p-7 reveal-scale-init stagger-${(index % 3) + 1}`}
          >
            <!-- Top Bar: Icon at Top Left -->
            <div class="relative z-10 flex items-start justify-between">
              <span class="w-8 h-8 sm:w-9 sm:h-9 text-slate-900 flex items-center justify-center" aria-hidden="true">
                {item.icon === 'workflow' && (
                  <svg class="w-7 h-7 sm:w-8 sm:h-8 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="3" y="3" width="6" height="6" rx="1.5" />
                    <rect x="15" y="3" width="6" height="6" rx="1.5" />
                    <rect x="9" y="15" width="6" height="6" rx="1.5" />
                    <path d="M6 9v3a3 3 0 0 0 3 3h3m6-6v3a3 3 0 0 1-3 3" />
                  </svg>
                )}
                {item.icon === 'ai' && (
                  <svg class="w-7 h-7 sm:w-8 sm:h-8 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M12 2v4m0 12v4M2 12h4m12 0h4" />
                    <circle cx="12" cy="12" r="4" />
                    <path d="m4.93 4.93 2.83 2.83m8.48 8.48 2.83 2.83M4.93 19.07l2.83-2.83m8.48-8.48 2.83-2.83" />
                  </svg>
                )}
                {item.icon === 'deployment' && (
                  <svg class="w-7 h-7 sm:w-8 sm:h-8 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="2" y="3" width="20" height="7" rx="2" />
                    <rect x="2" y="14" width="20" height="7" rx="2" />
                    <path d="M6 6.5h.01m4 0h.01m-4 11h.01m4 0h.01" stroke-width="2" stroke-linecap="round" />
                  </svg>
                )}
                {item.icon === 'modular' && (
                  <svg class="w-7 h-7 sm:w-8 sm:h-8 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="m12 2 10 5.5-10 5.5L2 7.5 12 2z" />
                    <path d="m2 12.5 10 5.5 10-5.5" />
                    <path d="m2 17.5 10 5.5 10-5.5" />
                  </svg>
                )}
                {item.icon === 'api' && (
                  <svg class="w-7 h-7 sm:w-8 sm:h-8 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="18" cy="5" r="3" />
                    <circle cx="6" cy="12" r="3" />
                    <circle cx="18" cy="19" r="3" />
                    <line x1="8.59" y1="13.51" x2="15.42" y2="17.49" />
                    <line x1="15.41" y1="6.51" x2="8.59" y2="10.49" />
                  </svg>
                )}
                {item.icon === 'database' && (
                  <svg class="w-7 h-7 sm:w-8 sm:h-8 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <ellipse cx="12" cy="5" rx="9" ry="3" />
                    <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3" />
                    <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" />
                  </svg>
                )}
                {item.icon === 'monitoring' && (
                  <svg class="w-7 h-7 sm:w-8 sm:h-8 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
                  </svg>
                )}
                {item.icon === 'governance' && (
                  <svg class="w-7 h-7 sm:w-8 sm:h-8 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <polyline points="16 11 18 13 22 9" />
                  </svg>
                )}
                {item.icon === 'shield' && (
                  <svg class="w-7 h-7 sm:w-8 sm:h-8 text-slate-900" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                    <path d="m9 12 2 2 4-4" />
                  </svg>
                )}
              </span>
            </div>

            <!-- Content Area at Bottom of Card -->
            <div class="relative z-10 mt-auto pt-4 sm:pt-6">
              <h3 class="text-lg sm:text-[21px] font-semibold tracking-[-0.025em] text-slate-950 font-sans leading-snug">
                {item.title}
              </h3>
              <p class="mt-2 text-xs sm:text-[13.5px] leading-relaxed text-slate-600 font-normal font-sans">
                {item.desc}
              </p>
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>

<style>
  .feature-card {
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 300ms cubic-bezier(0.16, 1, 0.3, 1), border-color 300ms ease;
  }

  .feature-card:hover {
    border-color: rgba(203, 213, 225, 0.9);
    transform: translateY(-3px);
    box-shadow: 0 16px 36px -8px rgba(0, 0, 0, 0.07);
  }

  /* Multi-spectrum Aurora Ambient Glow */
  .feature-card::before {
    position: absolute;
    top: -2.5rem;
    right: -2rem;
    z-index: 0;
    width: 14.5rem;
    height: 14.5rem;
    border-radius: 9999px;
    content: '';
    filter: blur(28px);
    pointer-events: none;
    transition: transform 400ms cubic-bezier(0.16, 1, 0.3, 1), opacity 400ms ease;
  }

  .feature-card:hover::before {
    transform: scale(1.08);
    opacity: 0.95;
  }

  /* 3 Harmonious Colors: 1 Color Theme per Row */

  /* Row 1 (Cards 0, 1, 2): Color 1 - Cyan & Sky Blue */
  .feature-row-0::before,
  .feature-card-0::before,
  .feature-card-1::before,
  .feature-card-2::before {
    background: 
      radial-gradient(circle at 62% 35%, rgba(6, 182, 212, 0.50) 0%, rgba(207, 250, 254, 0.20) 38%, transparent 68%),
      radial-gradient(circle at 82% 28%, rgba(14, 165, 233, 0.55) 0%, rgba(224, 242, 254, 0.28) 35%, transparent 72%);
  }

  /* Row 2 (Cards 3, 4, 5): Color 2 - Royal Blue & Indigo */
  .feature-row-1::before,
  .feature-card-3::before,
  .feature-card-4::before,
  .feature-card-5::before {
    background: 
      radial-gradient(circle at 62% 35%, rgba(59, 130, 246, 0.50) 0%, rgba(219, 234, 254, 0.20) 38%, transparent 68%),
      radial-gradient(circle at 82% 28%, rgba(99, 102, 241, 0.55) 0%, rgba(224, 231, 255, 0.28) 35%, transparent 72%);
  }

  /* Row 3 (Cards 6, 7, 8): Color 3 - Signature Violet & Cobalt */
  .feature-row-2::before,
  .feature-card-6::before,
  .feature-card-7::before,
  .feature-card-8::before {
    background: 
      radial-gradient(circle at 62% 35%, rgba(139, 92, 246, 0.55) 0%, rgba(237, 233, 254, 0.20) 38%, transparent 68%),
      radial-gradient(circle at 82% 28%, rgba(79, 70, 229, 0.50) 0%, rgba(224, 231, 255, 0.28) 35%, transparent 72%);
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-card {
      transition: none;
    }

    .feature-card:hover {
      transform: none;
    }

    .feature-card::before {
      transition: none;
    }

    .feature-card:hover::before {
      transform: none;
    }
  }
</style>
