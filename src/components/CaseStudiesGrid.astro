---
// src/components/CaseStudiesGrid.astro
// Responsive Case Studies Grid matching reference typography, glowing ambient sphere, and container-free cards
import { getTranslations, type Locale } from '../i18n/translations';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = getTranslations(lang);
const page = t.caseStudiesPage;
---

<div class="case-study-hero-wrapper relative w-full overflow-hidden bg-white">
  <!-- Glowing Mint/Cyan/Lime Ambient Sphere (Top Right) -->
  <div class="sphere-ambient-glow" aria-hidden="true">
    <picture>
      <source srcset="/case-studies/ambient_sphere.webp" type="image/webp" />
      <img
        src="/case-studies/ambient_sphere.png"
        alt=""
        class="w-full h-full object-contain pointer-events-none"
        loading="eager"
        decoding="async"
        width="1600"
        height="1600"
      />
    </picture>
  </div>

  <section class="relative pt-24 sm:pt-32 pb-20 sm:pb-28 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto z-10">
    <!-- Hero Header Section -->
    <div class="w-full max-w-4xl mx-auto text-center" data-reveal="fade">
      <h1 class="case-study-title text-3xl sm:text-[38px] md:text-[42px] text-slate-950 leading-[1.2]">
        {page.hero.title}
      </h1>
      <p class="case-study-subtitle text-sm sm:text-[15px] text-slate-500 leading-relaxed max-w-2xl mx-auto mt-3 sm:mt-3.5">
        {page.hero.subtitle}
      </p>
    </div>

    <!-- Case Studies 2-Column Grid (1-Col on Mobile) - Container-free Cards -->
    <div
      class="grid grid-cols-1 md:grid-cols-2 gap-8 sm:gap-10 lg:gap-12 mt-12 sm:mt-16 w-full"
      id="case-studies-container"
    >
      {page.items.map((item, idx) => (
        <article
          class="case-study-card group relative flex flex-col cursor-pointer"
          data-category={item.category}
          data-reveal="scale"
          class:list={[`stagger-${(idx % 4) + 1}`]}
        >
          <!-- Card Image without outer card container -->
          <div class="relative aspect-[16/10] sm:aspect-[16/9.5] w-full rounded-[18px] sm:rounded-[22px] overflow-hidden bg-slate-100 border border-slate-200/60 shadow-[0_4px_20px_rgba(0,0,0,0.03)] group-hover:shadow-[0_12px_32px_rgba(0,0,0,0.08)] transition-all duration-300">
            <picture>
              <source srcset={item.webp} type="image/webp" />
              <img
                src={item.image}
                alt={item.alt}
                class="w-full h-full object-cover object-center transition-transform duration-500 ease-out group-hover:scale-[1.02] select-none"
                loading={idx < 2 ? "eager" : "lazy"}
                decoding="async"
                width="1200"
                height="676"
              />
            </picture>
          </div>

          <!-- Content Info Footer (directly beneath image) -->
          <div class="flex items-start justify-between gap-4 mt-4 sm:mt-5 px-1">
            <div class="min-w-0 flex-1">
              <h2 class="case-study-card-title text-lg sm:text-xl font-semibold text-slate-950 tracking-tight leading-snug group-hover:text-indigo-600 transition-colors">
                {item.title}
              </h2>
              <p class="case-study-card-desc text-xs sm:text-sm text-slate-500 font-normal mt-1 leading-relaxed line-clamp-2">
                {item.subtitle}
              </p>
            </div>

            <!-- Industry Tag -->
            <div class="shrink-0 flex flex-col items-end">
              <span class="text-[11px] font-medium text-slate-400 mb-1 font-inter">
                {page.hero.industryLabel}
              </span>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium text-slate-700 bg-slate-100/90 border border-slate-200/60 whitespace-nowrap font-inter">
                {item.industry}
              </span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</div>

<style>
  .sphere-ambient-glow {
    position: absolute;
    top: -60px;
    right: -80px;
    width: 620px;
    height: 620px;
    pointer-events: none;
    user-select: none;
    z-index: 0;
    transform: translateZ(0);
  }

  @media (min-width: 1440px) {
    .sphere-ambient-glow {
      top: -70px;
      right: -100px;
      width: 660px;
      height: 660px;
    }
  }

  @media (max-width: 1024px) {
    .sphere-ambient-glow {
      top: -50px;
      right: -70px;
      width: 500px;
      height: 500px;
    }
  }

  @media (max-width: 640px) {
    .sphere-ambient-glow {
      top: -30px;
      right: -50px;
      width: 340px;
      height: 340px;
    }
  }

  .case-study-title {
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
    font-weight: 500 !important;
    letter-spacing: -0.02em !important;
  }
  .case-study-subtitle {
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
    font-weight: 400 !important;
    letter-spacing: -0.01em !important;
  }
  .case-study-card-title {
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
  }
  .case-study-card-desc {
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
  }
</style>
