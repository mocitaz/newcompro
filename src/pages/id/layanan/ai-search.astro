---
// src/pages/id/layanan/ai-search.astro
import Layout from "../../../layouts/Layout.astro";
import TopBar from "../../../components/TopBar.astro";
import AiSearchHero from "../../../components/services/AiSearchHero.astro";
import AiSearchFeatures from "../../../components/services/AiSearchFeatures.astro";
import AiSearchAboutService from "../../../components/services/AiSearchAboutService.astro";
import AiSearchFaq from "../../../components/services/AiSearchFaq.astro";
import LetsTalk from "../../../components/LetsTalk.astro";
import BackToTop from "../../../components/BackToTop.astro";
import { getTranslations } from "../../../i18n/translations";

const lang = "id";
const t = getTranslations(lang);
const meta = t.aiSearchService.meta;
---

<Layout
  lang={lang}
  title={meta.title}
  description={meta.description}
>
  <TopBar lang={lang} />
  
  <main id="main-content" class="min-h-screen bg-[#fbfbfc]">
    <!-- Hero Section with Frosted Card & 3D Architectural Medallion -->
    <AiSearchHero lang={lang} />

    <!-- Core Capabilities Features Section -->
    <AiSearchFeatures lang={lang} />

    <!-- Editorial Article with Sticky & Mobile Table of Contents -->
    <AiSearchAboutService lang={lang} />

    <!-- Service Specific FAQ Accordion -->
    <AiSearchFaq lang={lang} />

    <!-- Contact CTA Banner -->
    <LetsTalk lang={lang} />
  </main>

  <BackToTop label="Kembali ke atas" />
</Layout>
